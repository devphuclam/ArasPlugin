<UserControl x:Class="IdeaCadConnector.Desktop.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:IdeaCadConnector.Core.Localization;assembly=IdeaCadConnector.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1280">
    <UserControl.Resources>
        <SolidColorBrush x:Key="LibraryTextBrush" Color="#17305F"/>
        <SolidColorBrush x:Key="LibraryMutedBrush" Color="#687995"/>
        <SolidColorBrush x:Key="LibraryLineBrush" Color="#DDE5F1"/>
        <SolidColorBrush x:Key="LibraryPrimaryBrush" Color="#0B57F0"/>
        <SolidColorBrush x:Key="LibraryPanelBrush" Color="#FFFFFF"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style x:Key="LibraryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource LibraryPanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LibraryLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="LibraryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource LibraryTextBrush}"/>
            <Setter Property="BorderBrush" Value="#CCD8E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#F4F7FB"/>
                    <Setter Property="Foreground" Value="#A0AEC0"/>
                    <Setter Property="BorderBrush" Value="#D6DFEA"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LibraryPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource LibraryButtonStyle}">
            <Setter Property="Background" Value="{StaticResource LibraryPrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource LibraryPrimaryBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#D9E4F4"/>
                    <Setter Property="Foreground" Value="#7F8DA5"/>
                    <Setter Property="BorderBrush" Value="#D0D9E6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LibraryComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="#CCD8E8"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="LibraryDataGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EDF1F7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="56"/>
            <Setter Property="ColumnHeaderHeight" Value="42"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FBFCFE"/>
        </Style>

        <!-- Entry status colors -->
        <SolidColorBrush x:Key="StatusDraftBrush" Color="#F59E0B"/>
        <SolidColorBrush x:Key="StatusPendingReviewBrush" Color="#3B82F6"/>
        <SolidColorBrush x:Key="StatusPublishedBrush" Color="#16A34A"/>
        <SolidColorBrush x:Key="StatusDeprecatedBrush" Color="#6B7280"/>
        <SolidColorBrush x:Key="StatusErrorBrush" Color="#DC2626"/>
    </UserControl.Resources>

    <Grid Background="#F6F8FC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="24,18,24,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryTitle]}" FontSize="34" FontWeight="Bold"
                           Foreground="{StaticResource LibraryTextBrush}"/>
                <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibrarySubtitle]}"
                           Margin="0,6,0,0" FontSize="15"
                           Foreground="{StaticResource LibraryMutedBrush}"/>
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource LibraryCardStyle}" Padding="16,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="19" Background="#16A34A">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons"
                                   Foreground="White" FontSize="19"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,18,0">
                        <TextBlock Text="{Binding ConnectionTitle}" FontWeight="SemiBold"
                                   Foreground="{StaticResource LibraryTextBrush}"/>
                        <TextBlock Text="{Binding ConnectionDatabase}" FontSize="12"
                                   Foreground="{StaticResource LibraryMutedBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Margin="24,0,24,14" Style="{StaticResource LibraryCardStyle}" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <TextBox Height="40" Padding="36,0,12,0" VerticalContentAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             BorderBrush="#CCD8E8" Background="White"/>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="17"
                               Foreground="#275BB5" Margin="12,0,0,0"
                               VerticalAlignment="Center" HorizontalAlignment="Left"
                               IsHitTestVisible="False"/>
                </Grid>
                <ComboBox Grid.Column="2" Style="{StaticResource LibraryComboBoxStyle}"
                          ItemsSource="{Binding TypeFilters}" SelectedItem="{Binding SelectedTypeFilter}"/>
                <ComboBox Grid.Column="4" Style="{StaticResource LibraryComboBoxStyle}"
                          ItemsSource="{Binding StateFilters}" SelectedItem="{Binding SelectedStateFilter}"/>
                <ComboBox Grid.Column="6" Style="{StaticResource LibraryComboBoxStyle}"
                          ItemsSource="{Binding RevisionFilters}" SelectedItem="{Binding SelectedRevisionFilter}"/>
                <Button Grid.Column="8" Style="{StaticResource LibraryButtonStyle}"
                        Command="{Binding SearchCommand}" Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryButtonFilters]}"/>
                <Button Grid.Column="10" Style="{StaticResource LibraryButtonStyle}"
                        Command="{Binding CreateLibraryCommand}" Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryButtonCreateLibrary]}"/>
                <Button Grid.Column="12" Style="{StaticResource LibraryPrimaryButtonStyle}"
                        Command="{Binding AddPartCommand}" Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryButtonAddPart]}"/>
                <Button Grid.Column="14" Style="{StaticResource LibraryButtonStyle}"
                        Command="{Binding ShowPartPickerCommand}" Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryButtonPartPicker]}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="24,0,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*" MinWidth="520"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource LibraryCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="16,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryLibrariesHeader]}" FontSize="16" FontWeight="Bold"
                                       VerticalAlignment="Center" Foreground="{StaticResource LibraryTextBrush}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryButtonEditLibrary]}"
                                        Command="{Binding EditLibraryCommand}"
                                        Margin="0,0,4,0"
                                        Foreground="{StaticResource LibraryPrimaryBrush}"
                                        Background="Transparent" BorderThickness="0" FontWeight="SemiBold" FontSize="12"/>
                                <Button Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryButtonArchiveLibrary]}"
                                        Command="{Binding ArchiveLibraryCommand}"
                                        Margin="0,0,4,0"
                                        Foreground="#B91C1C"
                                        Background="Transparent" BorderThickness="0" FontWeight="SemiBold" FontSize="12"/>
                                <Button Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryButtonNew]}" Command="{Binding CreateLibraryCommand}"
                                        Foreground="{StaticResource LibraryPrimaryBrush}"
                                        Background="Transparent" BorderThickness="0" FontWeight="SemiBold" FontSize="12"/>
                            </StackPanel>
                        </Grid>
                        <ComboBox Grid.Row="1" Margin="0,6,0,0" Height="32"
                                  ItemsSource="{Binding VisibilityFilters}"
                                  SelectedItem="{Binding SelectedVisibilityFilter}"
                                  FontSize="12"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="8">
                        <ListBox ItemsSource="{Binding Libraries}"
                                 SelectedItem="{Binding SelectedLibrary}"
                                 BorderThickness="0" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="54" Margin="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons"
                                                   FontSize="17" Foreground="#16407E"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource LibraryTextBrush}"/>
                                            <TextBlock Text="{Binding ItemCount, StringFormat={}{0} items}"
                                                       FontSize="11" Foreground="{StaticResource LibraryMutedBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="&#xE712;" FontFamily="Segoe Fluent Icons"
                                                   Foreground="{StaticResource LibraryMutedBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border Background="#F7F9FD"
                                Visibility="{Binding ShowLibrariesOverlay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding LibrariesOverlayMessage}"
                                       Margin="16"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource LibraryMutedBrush}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource LibraryCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="48"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="16,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryItemsHeader]}" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource LibraryTextBrush}"/>
                            <TextBlock Text="{Binding ResultSummary}" FontSize="11"
                                       Foreground="{StaticResource LibraryMutedBrush}"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1">
                        <DataGrid Style="{StaticResource LibraryDataGridStyle}"
                                  ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}">
                            <DataGrid.Resources>
                                <Style x:Key="StatusBadgeStyle" TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="6,2"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EntryStatus}" Value="Draft">
                                            <Setter Property="Foreground" Value="{StaticResource StatusDraftBrush}"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EntryStatus}" Value="PendingReview">
                                            <Setter Property="Foreground" Value="{StaticResource StatusPendingReviewBrush}"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EntryStatus}" Value="Published">
                                            <Setter Property="Foreground" Value="{StaticResource StatusPublishedBrush}"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EntryStatus}" Value="Deprecated">
                                            <Setter Property="Foreground" Value="{StaticResource StatusDeprecatedBrush}"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="34">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <TextBlock Text="&#xE814;" FontFamily="Segoe Fluent Icons"
                                                           FontSize="16" Foreground="{StaticResource StatusErrorBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding ResolutionFailed, Converter={StaticResource BoolToVisibilityConverter}}"
                                                           ToolTip="{Binding ResolutionError}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryColumnPart]}" Binding="{Binding PartNumber}" Width="1.5*">
                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="ToolTip" Value="{Binding ResolutionError}"/>
                                        </Style>
                                    </DataGridTextColumn.CellStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryColumnType]}" Binding="{Binding PartType}" Width="0.8*"/>
                                <DataGridTextColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryColumnRevision]}" Binding="{Binding Revision}" Width="55"/>
                                <DataGridTextColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryColumnLifecycle]}" Binding="{Binding LifecycleState}" Width="0.9*"/>
                                <DataGridTemplateColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryColumnStatus]}" Width="0.9*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding EntryStatus}" Style="{StaticResource StatusBadgeStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryColumnRevisionPolicy]}" Binding="{Binding RevisionPolicy}" Width="1*"/>
                                <DataGridTextColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryColumnCadStatus]}" Binding="{Binding CadStatus}" Width="0.9*"/>
                                <DataGridTextColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryColumnUsage]}" Binding="{Binding UsageCount}" Width="60"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Background="#F7F9FD"
                                Visibility="{Binding ShowEntriesOverlay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding EntriesOverlayMessage}"
                                       Margin="16"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource LibraryMutedBrush}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"/>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="2" Margin="16,0">
                        <TextBlock Text="{Binding PagingSummary}" VerticalAlignment="Center"
                                   FontSize="11" Foreground="{StaticResource LibraryMutedBrush}"/>
                    </Grid>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource LibraryCardStyle}" Padding="16">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="54" Height="54" CornerRadius="15" Background="#7C3AED">
                                    <TextBlock Text="&#xE7B8;" FontFamily="Segoe Fluent Icons" FontSize="26"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedEntryDetails.PartNumber}"
                                               FontSize="22" FontWeight="Bold" Foreground="{StaticResource LibraryTextBrush}"/>
                                    <TextBlock Text="{Binding SelectedEntryDetails.PartName}"
                                                FontSize="12" Foreground="{StaticResource LibraryMutedBrush}"/>
                                </StackPanel>
                            </Grid>
                            <Border Margin="0,12,0,0"
                                    Padding="12"
                                    CornerRadius="10"
                                    Background="#FFF7ED"
                                    BorderBrush="#FDBA74"
                                    BorderThickness="1"
                                    Visibility="{Binding SelectedEntryDetails.HasNewerReleasedRevision, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryWarningNewerReleasedRevision]}"
                                           TextWrapping="Wrap"
                                           Foreground="#9A3412"
                                           FontWeight="SemiBold"/>
                            </Border>
                            <Border Margin="0,12,0,0"
                                    Padding="12"
                                    CornerRadius="10"
                                    Background="#FEF2F2"
                                    BorderBrush="#FCA5A5"
                                    BorderThickness="1"
                                    Visibility="{Binding SelectedEntryDetails.ResolutionFailed, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryWarningResolutionError]}"
                                               TextWrapping="Wrap"
                                               Foreground="#991B1B"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SelectedEntryDetails.ResolutionError}"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="#991B1B"
                                               FontSize="12"/>
                                </StackPanel>
                            </Border>
                            <TabControl Margin="0,14,0,0" BorderThickness="0">
                                <TabItem Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryTabOverview]}">
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/>
                                            <RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/>
                                            <RowDefinition Height="30"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryLabelType]}" Foreground="{StaticResource LibraryMutedBrush}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedEntryDetails.PartType}"/>
                                        <TextBlock Grid.Row="1" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryLabelRevision]}" Foreground="{StaticResource LibraryMutedBrush}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedEntryDetails.Revision}"/>
                                        <TextBlock Grid.Row="2" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryLabelState]}" Foreground="{StaticResource LibraryMutedBrush}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedEntryDetails.LifecycleState}"/>
                                        <TextBlock Grid.Row="3" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryLabelEntryStatus]}" Foreground="{StaticResource LibraryMutedBrush}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedEntryDetails.EntryLifecycleState}"/>
                                        <TextBlock Grid.Row="4" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryLabelLibrary]}" Foreground="{StaticResource LibraryMutedBrush}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedEntryDetails.LibraryName}"/>
                                        <TextBlock Grid.Row="5" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryLabelPolicy]}" Foreground="{StaticResource LibraryMutedBrush}"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedEntryDetails.RevisionPolicy}"/>
                                        <TextBlock Grid.Row="6" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryLabelUsage]}" Foreground="{StaticResource LibraryMutedBrush}"/>
                                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedEntryDetails.UsageCount}"/>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryTabCad]}"/>
                                <TabItem Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryTabBom]}"/>
                                <TabItem Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryTabRevisions]}"/>
                                <TabItem Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryTabWhereUsed]}">
                                    <Border Padding="12,10,12,4">
                                        <TextBlock Text="{Binding SelectedEntryDetails.WhereUsedSummary}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource LibraryMutedBrush}"/>
                                    </Border>
                                </TabItem>
                            </TabControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource LibraryCardStyle}" Padding="16" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryPrimaryCadTitle]}" FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource LibraryTextBrush}"/>
                            <TextBlock Text="{Binding SelectedEntryDetails.PrimaryCadFileName}"
                                       Margin="0,12,0,0" TextWrapping="Wrap"
                                       Foreground="{StaticResource LibraryTextBrush}"/>
                            <UniformGrid Columns="2" Margin="0,12,0,0">
                                <Button Style="{StaticResource LibraryButtonStyle}" Margin="0,0,5,0"
                                        Command="{Binding OpenInIronCadCommand}" Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryOpenInIronCad]}"/>
                                <Button Style="{StaticResource LibraryButtonStyle}" Margin="5,0,0,0"
                                        Command="{Binding DownloadCadCommand}" Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryDownloadCad]}"/>
                            </UniformGrid>
                            <Button Style="{StaticResource LibraryPrimaryButtonStyle}" Margin="0,10,0,0"
                                    Command="{Binding AddToCurrentProjectCommand}"
                                    Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryAddToProject]}"/>
                            <TextBlock Text="{Binding AddToProjectHint}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource LibraryMutedBrush}"
                                       FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource LibraryCardStyle}" Padding="16" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryQuickActionsTitle]}" FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource LibraryTextBrush}"/>
                            <UniformGrid Columns="2" Margin="0,10,0,0">
                                <Button Style="{StaticResource LibraryButtonStyle}" Margin="0,0,8,8"
                                        Command="{Binding ViewWhereUsedCommand}" Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryViewWhereUsed]}"/>
                                <Button Style="{StaticResource LibraryButtonStyle}" Margin="8,0,0,8"
                                        Command="{Binding PinRevisionCommand}" Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryPinCurrentRevision]}"/>
                                <Button Style="{StaticResource LibraryButtonStyle}" Margin="0,0,8,8"
                                        Command="{Binding UseLatestReleasedCommand}" Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryUseLatestReleased]}"/>
                                <Button Style="{StaticResource LibraryButtonStyle}" Margin="8,0,0,8"
                                        Command="{Binding PublishCommand}" Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryPublishEntry]}"/>
                                <Button Style="{StaticResource LibraryButtonStyle}" Margin="0,0,8,0"
                                        Command="{Binding DeprecateCommand}" Foreground="#B91C1C" Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryDeprecateEntry]}"/>
                                <Button Style="{StaticResource LibraryButtonStyle}" Margin="8,0,0,0"
                                        Command="{Binding RemoveEntryCommand}" Foreground="#B91C1C" Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryRemoveEntry]}"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="3" Background="White" BorderBrush="#E5EBF3" BorderThickness="0,1,0,0" Padding="24,7">
            <Grid>
                <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryFooter]}" FontSize="11"
                           Foreground="{StaticResource LibraryMutedBrush}"/>
                <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Center" FontSize="11"
                           Foreground="{StaticResource LibraryMutedBrush}"/>
                <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryFooterVersion]}" HorizontalAlignment="Right" FontSize="11"
                           Foreground="{StaticResource LibraryMutedBrush}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
