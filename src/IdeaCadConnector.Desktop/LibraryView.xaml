<UserControl x:Class="IdeaCadConnector.Desktop.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1280">
    <UserControl.Resources>
        <SolidColorBrush x:Key="LibraryTextBrush" Color="#17305F"/>
        <SolidColorBrush x:Key="LibraryMutedBrush" Color="#687995"/>
        <SolidColorBrush x:Key="LibraryLineBrush" Color="#DDE5F1"/>
        <SolidColorBrush x:Key="LibraryPrimaryBrush" Color="#0B57F0"/>
        <SolidColorBrush x:Key="LibraryPanelBrush" Color="#FFFFFF"/>

        <Style x:Key="LibraryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource LibraryPanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LibraryLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="LibraryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource LibraryTextBrush}"/>
            <Setter Property="BorderBrush" Value="#CCD8E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LibraryPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource LibraryButtonStyle}">
            <Setter Property="Background" Value="{StaticResource LibraryPrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource LibraryPrimaryBrush}"/>
        </Style>

        <Style x:Key="LibraryComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="#CCD8E8"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="LibraryDataGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EDF1F7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="56"/>
            <Setter Property="ColumnHeaderHeight" Value="42"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FBFCFE"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F6F8FC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="24,18,24,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Part Library" FontSize="34" FontWeight="Bold"
                           Foreground="{StaticResource LibraryTextBrush}"/>
                <TextBlock Text="Search, organize, and reuse approved Parts across PDM projects."
                           Margin="0,6,0,0" FontSize="15"
                           Foreground="{StaticResource LibraryMutedBrush}"/>
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource LibraryCardStyle}" Padding="16,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="19" Background="#16A34A">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons"
                                   Foreground="White" FontSize="19"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,18,0">
                        <TextBlock Text="{Binding ConnectionTitle}" FontWeight="SemiBold"
                                   Foreground="{StaticResource LibraryTextBrush}"/>
                        <TextBlock Text="{Binding ConnectionDatabase}" FontSize="12"
                                   Foreground="{StaticResource LibraryMutedBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Margin="24,0,24,14" Style="{StaticResource LibraryCardStyle}" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <TextBox Height="40" Padding="36,0,12,0" VerticalContentAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             BorderBrush="#CCD8E8" Background="White"/>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="17"
                               Foreground="#275BB5" Margin="12,0,0,0"
                               VerticalAlignment="Center" HorizontalAlignment="Left"
                               IsHitTestVisible="False"/>
                </Grid>
                <ComboBox Grid.Column="2" Style="{StaticResource LibraryComboBoxStyle}"
                          ItemsSource="{Binding TypeFilters}" SelectedItem="{Binding SelectedTypeFilter}"/>
                <ComboBox Grid.Column="4" Style="{StaticResource LibraryComboBoxStyle}"
                          ItemsSource="{Binding StateFilters}" SelectedItem="{Binding SelectedStateFilter}"/>
                <ComboBox Grid.Column="6" Style="{StaticResource LibraryComboBoxStyle}"
                          ItemsSource="{Binding RevisionFilters}" SelectedItem="{Binding SelectedRevisionFilter}"/>
                <Button Grid.Column="8" Style="{StaticResource LibraryButtonStyle}"
                        Command="{Binding SearchCommand}" Content="Filters"/>
                <Button Grid.Column="10" Style="{StaticResource LibraryButtonStyle}"
                        Command="{Binding CreateLibraryCommand}" Content="+ Create Library"/>
                <Button Grid.Column="12" Style="{StaticResource LibraryPrimaryButtonStyle}"
                        Command="{Binding AddPartCommand}" Content="+ Add Part"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="24,0,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*" MinWidth="520"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource LibraryCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="16,0">
                        <TextBlock Text="Libraries" FontSize="16" FontWeight="Bold"
                                   VerticalAlignment="Center" Foreground="{StaticResource LibraryTextBrush}"/>
                        <Button Content="+ New" Command="{Binding CreateLibraryCommand}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Foreground="{StaticResource LibraryPrimaryBrush}"
                                Background="Transparent" BorderThickness="0" FontWeight="SemiBold"/>
                    </Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Libraries}"
                             SelectedItem="{Binding SelectedLibrary}"
                             BorderThickness="0" Background="Transparent" Margin="8">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="54" Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons"
                                               FontSize="17" Foreground="#16407E"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   Foreground="{StaticResource LibraryTextBrush}"/>
                                        <TextBlock Text="{Binding ItemCount, StringFormat={}{0} items}"
                                                   FontSize="11" Foreground="{StaticResource LibraryMutedBrush}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="&#xE712;" FontFamily="Segoe Fluent Icons"
                                               Foreground="{StaticResource LibraryMutedBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource LibraryCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="48"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="16,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Library Items" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource LibraryTextBrush}"/>
                            <TextBlock Text="{Binding ResultSummary}" FontSize="11"
                                       Foreground="{StaticResource LibraryMutedBrush}"/>
                        </StackPanel>
                    </Grid>
                    <DataGrid Grid.Row="1" Style="{StaticResource LibraryDataGridStyle}"
                              ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Part" Binding="{Binding PartNumber}" Width="1.6*"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding PartType}" Width="0.9*"/>
                            <DataGridTextColumn Header="Rev" Binding="{Binding Revision}" Width="55"/>
                            <DataGridTextColumn Header="Lifecycle" Binding="{Binding LifecycleState}" Width="1*"/>
                            <DataGridTextColumn Header="Revision policy" Binding="{Binding RevisionPolicy}" Width="1.15*"/>
                            <DataGridTextColumn Header="CAD status" Binding="{Binding CadStatus}" Width="1*"/>
                            <DataGridTextColumn Header="Usage" Binding="{Binding UsageCount}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="2" Margin="16,0">
                        <TextBlock Text="{Binding PagingSummary}" VerticalAlignment="Center"
                                   FontSize="11" Foreground="{StaticResource LibraryMutedBrush}"/>
                    </Grid>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource LibraryCardStyle}" Padding="16">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="54" Height="54" CornerRadius="15" Background="#7C3AED">
                                    <TextBlock Text="&#xE7B8;" FontFamily="Segoe Fluent Icons" FontSize="26"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedEntryDetails.PartNumber, TargetNullValue=Select a Part}"
                                               FontSize="22" FontWeight="Bold" Foreground="{StaticResource LibraryTextBrush}"/>
                                    <TextBlock Text="{Binding SelectedEntryDetails.PartName}"
                                               FontSize="12" Foreground="{StaticResource LibraryMutedBrush}"/>
                                </StackPanel>
                            </Grid>
                            <TabControl Margin="0,14,0,0" BorderThickness="0">
                                <TabItem Header="Overview">
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/>
                                            <RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Type" Foreground="{StaticResource LibraryMutedBrush}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedEntryDetails.PartType}"/>
                                        <TextBlock Grid.Row="1" Text="Revision" Foreground="{StaticResource LibraryMutedBrush}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedEntryDetails.Revision}"/>
                                        <TextBlock Grid.Row="2" Text="State" Foreground="{StaticResource LibraryMutedBrush}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedEntryDetails.LifecycleState}"/>
                                        <TextBlock Grid.Row="3" Text="Library" Foreground="{StaticResource LibraryMutedBrush}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedEntryDetails.LibraryName}"/>
                                        <TextBlock Grid.Row="4" Text="Policy" Foreground="{StaticResource LibraryMutedBrush}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedEntryDetails.RevisionPolicy}"/>
                                        <TextBlock Grid.Row="5" Text="Usage" Foreground="{StaticResource LibraryMutedBrush}"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedEntryDetails.UsageCount}"/>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="CAD"/>
                                <TabItem Header="BOM"/>
                                <TabItem Header="Revisions"/>
                                <TabItem Header="Where Used">
                                    <Border Padding="12,10,12,4">
                                        <TextBlock Text="{Binding SelectedEntryDetails.WhereUsedSummary, TargetNullValue=Select View Where Used to load reuse information.}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource LibraryMutedBrush}"/>
                                    </Border>
                                </TabItem>
                            </TabControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource LibraryCardStyle}" Padding="16" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Primary CAD" FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource LibraryTextBrush}"/>
                            <TextBlock Text="{Binding SelectedEntryDetails.PrimaryCadFileName, TargetNullValue=No linked CAD}"
                                       Margin="0,12,0,0" TextWrapping="Wrap"
                                       Foreground="{StaticResource LibraryTextBrush}"/>
                            <UniformGrid Columns="2" Margin="0,12,0,0">
                                <Button Style="{StaticResource LibraryButtonStyle}" Margin="0,0,5,0"
                                        Command="{Binding OpenInIronCadCommand}" Content="Open in IronCAD"/>
                                <Button Style="{StaticResource LibraryButtonStyle}" Margin="5,0,0,0"
                                        Command="{Binding DownloadCadCommand}" Content="Download"/>
                            </UniformGrid>
                            <Button Style="{StaticResource LibraryPrimaryButtonStyle}" Margin="0,10,0,0"
                                    Command="{Binding AddToCurrentProjectCommand}"
                                    Content="+ Add to Current PDM Project"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource LibraryCardStyle}" Padding="16" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Quick Actions" FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource LibraryTextBrush}"/>
                            <Button Style="{StaticResource LibraryButtonStyle}" Margin="0,10,0,0"
                                    Command="{Binding ViewWhereUsedCommand}" Content="View Where Used"/>
                            <Button Style="{StaticResource LibraryButtonStyle}" Margin="0,8,0,0"
                                    Command="{Binding PinRevisionCommand}" Content="Pin Current Revision"/>
                            <Button Style="{StaticResource LibraryButtonStyle}" Margin="0,8,0,0"
                                    Command="{Binding OpenInArasCommand}" Content="Open in Aras Innovator"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="3" Background="White" BorderBrush="#E5EBF3" BorderThickness="0,1,0,0" Padding="24,7">
            <Grid>
                <TextBlock Text="IDEA PDM – IronCAD / Aras Innovator" FontSize="11"
                           Foreground="{StaticResource LibraryMutedBrush}"/>
                <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Center" FontSize="11"
                           Foreground="{StaticResource LibraryMutedBrush}"/>
                <TextBlock Text="v1.1.0 library preview" HorizontalAlignment="Right" FontSize="11"
                           Foreground="{StaticResource LibraryMutedBrush}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
