<UserControl x:Class="IdeaCadConnector.Desktop.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:IdeaCadConnector.Core.Localization;assembly=IdeaCadConnector.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1280">
    <UserControl.Resources>
        <SolidColorBrush x:Key="LibraryTextBrush" Color="#142B5C"/>
        <SolidColorBrush x:Key="LibraryMutedBrush" Color="#637391"/>
        <SolidColorBrush x:Key="LibraryLineBrush" Color="#D8E2F0"/>
        <SolidColorBrush x:Key="LibraryPrimaryBrush" Color="#155EEF"/>
        <SolidColorBrush x:Key="LibraryPrimarySoftBrush" Color="#EAF2FF"/>
        <SolidColorBrush x:Key="LibraryPanelBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="LibrarySurfaceBrush" Color="#F4F7FB"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style x:Key="LibraryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource LibraryPanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LibraryLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" Direction="270" ShadowDepth="3" Color="#223A5E" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LibraryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource LibraryTextBrush}"/>
            <Setter Property="BorderBrush" Value="#CCD8E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F6FAFF"/>
                    <Setter Property="BorderBrush" Value="#9AB4E5"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#F4F7FB"/>
                    <Setter Property="Foreground" Value="#A0AEC0"/>
                    <Setter Property="BorderBrush" Value="#D6DFEA"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LibraryPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource LibraryButtonStyle}">
            <Setter Property="Background" Value="{StaticResource LibraryPrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource LibraryPrimaryBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0B4BD8"/>
                    <Setter Property="BorderBrush" Value="#0B4BD8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#D9E4F4"/>
                    <Setter Property="Foreground" Value="#7F8DA5"/>
                    <Setter Property="BorderBrush" Value="#D0D9E6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LibraryComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,6,34,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#C5D5E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFCFDFF"/>
            <Setter Property="Foreground" Value="{StaticResource LibraryTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.65"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Foreground" Value="{StaticResource LibraryTextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemChrome"
                                Margin="4,2"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="10"
                                Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource LibraryPrimarySoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#DDEBFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LibraryTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="36,0,12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource LibraryTextBrush}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCD8E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TextBoxChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TextBoxChrome" Property="BorderBrush" Value="{StaticResource LibraryPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LibraryDataGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EAF0F8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="58"/>
            <Setter Property="ColumnHeaderHeight" Value="42"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FCFDFF"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F3F6FB"/>
                        <Setter Property="Foreground" Value="#526480"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="BorderBrush" Value="#E5ECF5"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Foreground" Value="{StaticResource LibraryTextBrush}"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F7FAFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#EAF2FF"/>
                                <Setter Property="Foreground" Value="{StaticResource LibraryTextBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LibraryListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemChrome" CornerRadius="8" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#F6FAFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource LibraryPrimarySoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LibraryTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="#526480"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" Background="Transparent"/>
                            <ContentPresenter ContentSource="Header"
                                              Margin="0,0,0,9"
                                              MinWidth="52"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource LibraryPrimaryBrush}"/>
                                <Setter TargetName="Underline" Property="Background" Value="{StaticResource LibraryPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Entry status colors -->
        <SolidColorBrush x:Key="StatusDraftBrush" Color="#F59E0B"/>
        <SolidColorBrush x:Key="StatusPendingReviewBrush" Color="#3B82F6"/>
        <SolidColorBrush x:Key="StatusPublishedBrush" Color="#16A34A"/>
        <SolidColorBrush x:Key="StatusDeprecatedBrush" Color="#6B7280"/>
        <SolidColorBrush x:Key="StatusErrorBrush" Color="#DC2626"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource LibrarySurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="24,20,24,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryTitle]}" FontSize="32" FontWeight="Bold"
                           Foreground="{StaticResource LibraryTextBrush}"/>
                <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibrarySubtitle]}"
                           Margin="0,6,0,0" FontSize="15"
                           Foreground="{StaticResource LibraryMutedBrush}"/>
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource LibraryCardStyle}" Padding="16,10" MinWidth="270">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="19" Background="#16A34A">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons"
                                   Foreground="White" FontSize="19"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,18,0">
                        <TextBlock Text="{Binding ConnectionTitle}" FontWeight="SemiBold"
                                   Foreground="{StaticResource LibraryTextBrush}"/>
                        <TextBlock Text="{Binding ConnectionDatabase}" FontSize="12"
                                   Foreground="{StaticResource LibraryMutedBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Margin="24,0,24,16" Style="{StaticResource LibraryCardStyle}" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.4*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="152"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="152"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="152"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <TextBox Style="{StaticResource LibraryTextBoxStyle}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[SearchHint]}"/>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="17"
                               Foreground="#275BB5" Margin="12,0,0,0"
                               VerticalAlignment="Center" HorizontalAlignment="Left"
                               IsHitTestVisible="False"/>
                </Grid>
                <ComboBox Grid.Column="2" Style="{StaticResource LibraryComboBoxStyle}"
                          ItemsSource="{Binding TypeFilters}" SelectedItem="{Binding SelectedTypeFilter}"/>
                <ComboBox Grid.Column="4" Style="{StaticResource LibraryComboBoxStyle}"
                          ItemsSource="{Binding StateFilters}" SelectedItem="{Binding SelectedStateFilter}"/>
                <ComboBox Grid.Column="6" Style="{StaticResource LibraryComboBoxStyle}"
                          ItemsSource="{Binding RevisionFilters}" SelectedItem="{Binding SelectedRevisionFilter}"/>
                <Button Grid.Column="8" Style="{StaticResource LibraryButtonStyle}"
                        Command="{Binding SearchCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71C;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryButtonFilters]}"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="10" Style="{StaticResource LibraryButtonStyle}"
                        Command="{Binding CreateLibraryCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryButtonCreateLibrary]}"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="12" Style="{StaticResource LibraryPrimaryButtonStyle}"
                        Command="{Binding AddPartCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryButtonAddPart]}"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="14" Style="{StaticResource LibraryButtonStyle}"
                        Command="{Binding ShowPartPickerCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryButtonPartPicker]}"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

            <Grid Grid.Row="2" Margin="24,0,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="238"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*" MinWidth="520"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="372"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource LibraryCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="16,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryLibrariesHeader]}" FontSize="16" FontWeight="Bold"
                                       VerticalAlignment="Center" Foreground="{StaticResource LibraryTextBrush}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryButtonEditLibrary]}"
                                        Command="{Binding EditLibraryCommand}"
                                        Margin="0,0,4,0"
                                        Foreground="{StaticResource LibraryPrimaryBrush}"
                                        Background="Transparent" BorderThickness="0" FontWeight="SemiBold" FontSize="12"/>
                                <Button Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryButtonArchiveLibrary]}"
                                        Command="{Binding ArchiveLibraryCommand}"
                                        Margin="0,0,4,0"
                                        Foreground="#B91C1C"
                                        Background="Transparent" BorderThickness="0" FontWeight="SemiBold" FontSize="12"/>
                                <Button Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryButtonNew]}" Command="{Binding CreateLibraryCommand}"
                                        Foreground="{StaticResource LibraryPrimaryBrush}"
                                        Background="Transparent" BorderThickness="0" FontWeight="SemiBold" FontSize="12"/>
                            </StackPanel>
                        </Grid>
                        <ComboBox Grid.Row="1" Margin="0,8,0,0" Height="36"
                                  Style="{StaticResource LibraryComboBoxStyle}"
                                  ItemsSource="{Binding VisibilityFilters}"
                                  SelectedItem="{Binding SelectedVisibilityFilter}"
                                  FontSize="12"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="8">
                        <ListBox ItemsSource="{Binding Libraries}"
                                 SelectedItem="{Binding SelectedLibrary}"
                                 BorderThickness="0" Background="Transparent"
                                 ItemContainerStyle="{StaticResource LibraryListBoxItemStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="56" Margin="8,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="18" Height="18" CornerRadius="5" Background="{StaticResource LibraryPrimarySoftBrush}"
                                                VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons"
                                                       FontSize="11" Foreground="{StaticResource LibraryPrimaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource LibraryTextBrush}"/>
                                            <TextBlock Text="{Binding ItemCount, StringFormat={}{0} items}"
                                                       FontSize="11" Foreground="{StaticResource LibraryMutedBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="&#xE712;" FontFamily="Segoe Fluent Icons"
                                                   Foreground="{StaticResource LibraryMutedBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border Background="#F7F9FD"
                                Visibility="{Binding ShowLibrariesOverlay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding LibrariesOverlayMessage}"
                                       Margin="16"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource LibraryMutedBrush}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource LibraryCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="48"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="16,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryItemsHeader]}" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource LibraryTextBrush}"/>
                            <TextBlock Text="{Binding ResultSummary}" FontSize="11"
                                       Foreground="{StaticResource LibraryMutedBrush}"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1">
                        <DataGrid Style="{StaticResource LibraryDataGridStyle}"
                                  ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}">
                            <DataGrid.Resources>
                                <Style x:Key="StatusBadgeStyle" TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="6,2"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EntryStatus}" Value="Draft">
                                            <Setter Property="Foreground" Value="{StaticResource StatusDraftBrush}"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EntryStatus}" Value="PendingReview">
                                            <Setter Property="Foreground" Value="{StaticResource StatusPendingReviewBrush}"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EntryStatus}" Value="Published">
                                            <Setter Property="Foreground" Value="{StaticResource StatusPublishedBrush}"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EntryStatus}" Value="Deprecated">
                                            <Setter Property="Foreground" Value="{StaticResource StatusDeprecatedBrush}"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="34">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Border Width="24" Height="24" CornerRadius="7" Background="#FEF2F2"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding ResolutionFailed, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        ToolTip="{Binding ResolutionError}">
                                                    <TextBlock Text="&#xE814;" FontFamily="Segoe Fluent Icons"
                                                               FontSize="13" Foreground="{StaticResource StatusErrorBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryColumnPart]}" Width="2.2*" MinWidth="220">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid ToolTip="{Binding ResolutionError}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="24" Height="24" CornerRadius="7" Background="#14B86A"
                                                        VerticalAlignment="Center" HorizontalAlignment="Left">
                                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons"
                                                               FontSize="12" Foreground="White"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding PartNumber}" FontWeight="Bold"
                                                               Foreground="{StaticResource LibraryTextBrush}"/>
                                                    <TextBlock Text="{Binding PartName}" FontSize="11"
                                                               Foreground="{StaticResource LibraryMutedBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryColumnRevision]}" Binding="{Binding Revision}" Width="55"/>
                                <DataGridTemplateColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryColumnLifecycle]}" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="8" Background="#ECFDF3" Padding="8,3"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Fill="#16A34A" Margin="0,0,6,0"
                                                             VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding LifecycleState}" Foreground="#087A3C"
                                                               FontSize="11" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryColumnStatus]}" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="8" Background="#EFF6FF" Padding="8,3"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding EntryStatus}" Style="{StaticResource StatusBadgeStyle}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Policy" Binding="{Binding RevisionPolicy}" Width="120"/>
                                <DataGridTemplateColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryColumnCadStatus]}" Width="1.7*" MinWidth="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="8" Background="#E6FAF5" Padding="8,3"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CadStatus}" Foreground="#0F8F86"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding CadStatus}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryColumnUsage]}" Binding="{Binding UsageCount}" Width="55"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Background="#F7F9FD"
                                Visibility="{Binding ShowEntriesOverlay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding EntriesOverlayMessage}"
                                       Margin="16"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource LibraryMutedBrush}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"/>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="2" Margin="16,0">
                        <TextBlock Text="{Binding PagingSummary}" VerticalAlignment="Center"
                                   FontSize="11" Foreground="{StaticResource LibraryMutedBrush}"/>
                    </Grid>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource LibraryCardStyle}" Padding="18">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="58" Height="58" CornerRadius="12" Background="#7C3AED">
                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons" FontSize="24"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedEntryDetails.PartNumber}"
                                               FontSize="22" FontWeight="Bold" Foreground="{StaticResource LibraryTextBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding SelectedEntryDetails.PartName}"
                                               Margin="0,4,0,0"
                                               FontSize="13" Foreground="{StaticResource LibraryMutedBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                            <Border Margin="0,12,0,0"
                                    Padding="12"
                                    CornerRadius="10"
                                    Background="#FFF7ED"
                                    BorderBrush="#FDBA74"
                                    BorderThickness="1"
                                    Visibility="{Binding SelectedEntryDetails.HasNewerReleasedRevision, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryWarningNewerReleasedRevision]}"
                                           TextWrapping="Wrap"
                                           Foreground="#9A3412"
                                           FontWeight="SemiBold"/>
                            </Border>
                            <Border Margin="0,12,0,0"
                                    Padding="12"
                                    CornerRadius="10"
                                    Background="#FEF2F2"
                                    BorderBrush="#FCA5A5"
                                    BorderThickness="1"
                                    Visibility="{Binding SelectedEntryDetails.ResolutionFailed, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryWarningResolutionError]}"
                                               TextWrapping="Wrap"
                                               Foreground="#991B1B"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SelectedEntryDetails.ResolutionError}"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="#991B1B"
                                               FontSize="12"/>
                                </StackPanel>
                            </Border>
                            <TabControl Margin="0,16,0,0" BorderThickness="0" Background="Transparent"
                                        ItemContainerStyle="{StaticResource LibraryTabItemStyle}">
                                <TabItem>
                                    <TabItem.Header>
                                        <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryTabOverview]}"/>
                                    </TabItem.Header>
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/>
                                            <RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/>
                                            <RowDefinition Height="30"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryLabelType]}" Foreground="{StaticResource LibraryMutedBrush}" FontSize="12"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedEntryDetails.PartType}" Foreground="{StaticResource LibraryTextBrush}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="1" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryLabelRevision]}" Foreground="{StaticResource LibraryMutedBrush}" FontSize="12"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedEntryDetails.Revision}" Foreground="{StaticResource LibraryTextBrush}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="2" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryLabelState]}" Foreground="{StaticResource LibraryMutedBrush}" FontSize="12"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedEntryDetails.LifecycleState}" Foreground="{StaticResource LibraryTextBrush}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="3" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryLabelEntryStatus]}" Foreground="{StaticResource LibraryMutedBrush}" FontSize="12"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedEntryDetails.EntryLifecycleState}" Foreground="{StaticResource LibraryTextBrush}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="4" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryLabelLibrary]}" Foreground="{StaticResource LibraryMutedBrush}" FontSize="12"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedEntryDetails.LibraryName}" Foreground="{StaticResource LibraryTextBrush}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="5" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryLabelPolicy]}" Foreground="{StaticResource LibraryMutedBrush}" FontSize="12"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedEntryDetails.RevisionPolicy}" Foreground="{StaticResource LibraryTextBrush}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="6" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryLabelUsage]}" Foreground="{StaticResource LibraryMutedBrush}" FontSize="12"/>
                                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedEntryDetails.UsageCount}" Foreground="{StaticResource LibraryTextBrush}" FontWeight="SemiBold"/>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryTabCad]}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                                        <StackPanel>
                                            <Border Visibility="{Binding IsLoadingDetails, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{Binding DetailStatusMessage}" Foreground="{StaticResource LibraryMutedBrush}" Margin="8"/>
                                            </Border>
                                            <Border Visibility="{Binding DetailErrorMessage, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{Binding DetailErrorMessage}" Foreground="{StaticResource StatusErrorBrush}" Margin="8" TextWrapping="Wrap"/>
                                            </Border>
                                            <Grid Margin="8" Visibility="{Binding HasCadDetails, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="28"/><RowDefinition Height="28"/>
                                                <RowDefinition Height="28"/><RowDefinition Height="28"/>
                                                <RowDefinition Height="28"/><RowDefinition Height="28"/>
                                                <RowDefinition Height="28"/><RowDefinition Height="28"/>
                                                <RowDefinition Height="28"/>
                                            </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryCadLabelCadNumber]}" Foreground="{StaticResource LibraryMutedBrush}"/>
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedCadDetails.PrimaryCadNumber}"/>
                                                <TextBlock Grid.Row="1" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryCadLabelCadName]}" Foreground="{StaticResource LibraryMutedBrush}"/>
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedCadDetails.PrimaryCadName}"/>
                                                <TextBlock Grid.Row="2" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryCadLabelCadState]}" Foreground="{StaticResource LibraryMutedBrush}"/>
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedCadDetails.PrimaryCadState}"/>
                                                <TextBlock Grid.Row="3" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryCadLabelFileId]}" Foreground="{StaticResource LibraryMutedBrush}"/>
                                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedCadDetails.FileId}"/>
                                                <TextBlock Grid.Row="4" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryCadLabelFileName]}" Foreground="{StaticResource LibraryMutedBrush}"/>
                                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedCadDetails.FileName}"/>
                                                <TextBlock Grid.Row="5" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryCadLabelFileVersion]}" Foreground="{StaticResource LibraryMutedBrush}"/>
                                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedCadDetails.FileVersion}"/>
                                                <TextBlock Grid.Row="6" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryCadLabelLockedBy]}" Foreground="{StaticResource LibraryMutedBrush}"/>
                                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedCadDetails.LockedBy}"/>
                                                <TextBlock Grid.Row="7" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryCadLabelHasNative]}" Foreground="{StaticResource LibraryMutedBrush}"/>
                                                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedCadDetails.HasNative}"/>
                                                <TextBlock Grid.Row="8" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryColumnCadStatus]}" Foreground="{StaticResource LibraryMutedBrush}"/>
                                                <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding SelectedCadDetails.CadStatus}"/>
                                            </Grid>
                                            <UniformGrid Columns="3" Margin="8">
                                                <Button Style="{StaticResource LibraryButtonStyle}" Margin="0,0,4,0"
                                                        Command="{Binding OpenInIronCadCommand}"
                                                        Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryCadButtonOpenInIronCad]}"/>
                                                <Button Style="{StaticResource LibraryButtonStyle}" Margin="4,0,4,0"
                                                        Command="{Binding DownloadCadCommand}"
                                                        Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryCadButtonDownload]}"/>
                                                <Button Style="{StaticResource LibraryButtonStyle}" Margin="4,0,0,0"
                                                        Command="{Binding OpenSelectedEntryInArasCommand}"
                                                        Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryCadButtonOpenInAras]}"/>
                                            </UniformGrid>
                                            <TextBlock Text="{Binding SelectedCadDetails.CadStatus}"
                                                        Margin="8"
                                                        Foreground="{StaticResource LibraryMutedBrush}"
                                                        Visibility="{Binding HasNoCadDetails, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryTabBom]}">
                                    <Grid Margin="0,8,0,0">
                                        <DataGrid Style="{StaticResource LibraryDataGridStyle}"
                                                  ItemsSource="{Binding SelectedBomDetails.Items}"
                                                  Visibility="{Binding HasBomItems, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryBomColumnComponentPartNumber]}" Binding="{Binding ComponentPartNumber}" Width="*"/>
                                                <DataGridTextColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryBomColumnComponentName]}" Binding="{Binding ComponentName}" Width="*"/>
                                                <DataGridTextColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryBomColumnRevision]}" Binding="{Binding ComponentRevision}" Width="70"/>
                                                <DataGridTextColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryBomColumnQuantity]}" Binding="{Binding Quantity}" Width="60"/>
                                                <DataGridTextColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryBomColumnUnit]}" Binding="{Binding Unit}" Width="60"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryBomNoItems]}"
                                                   Margin="8"
                                                   Foreground="{StaticResource LibraryMutedBrush}"
                                                   Visibility="{Binding HasNoBomItems, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </Grid>
                                </TabItem>
                                <TabItem>
                                    <TabItem.Header>
                                        <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryTabRevisions]}"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"/>
                                    </TabItem.Header>
                                    <Grid Margin="0,8,0,0">
                                        <DataGrid Style="{StaticResource LibraryDataGridStyle}"
                                                  ItemsSource="{Binding SelectedRevisionDetails.Items}"
                                                  Visibility="{Binding HasRevisionItems, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryRevisionColumnPartId]}" Binding="{Binding PartId}" Width="*"/>
                                                <DataGridTextColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryRevisionColumnRevision]}" Binding="{Binding Revision}" Width="70"/>
                                                <DataGridTextColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryRevisionColumnGeneration]}" Binding="{Binding Generation}" Width="70"/>
                                                <DataGridTextColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryRevisionColumnLifecycleState]}" Binding="{Binding LifecycleState}" Width="*"/>
                                                <DataGridTextColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryRevisionColumnModifiedOn]}" Binding="{Binding ModifiedOn}" Width="*"/>
                                                <DataGridTextColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryRevisionColumnIsCurrent]}" Binding="{Binding IsCurrent}" Width="60"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryRevisionNoRevisions]}"
                                                   Margin="8"
                                                   Foreground="{StaticResource LibraryMutedBrush}"
                                                   Visibility="{Binding HasNoRevisionItems, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </Grid>
                                </TabItem>
                                <TabItem>
                                    <TabItem.Header>
                                        <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryTabWhereUsed]}"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"/>
                                    </TabItem.Header>
                                    <Grid Margin="0,8,0,0">
                                        <DataGrid Style="{StaticResource LibraryDataGridStyle}"
                                                  ItemsSource="{Binding SelectedWhereUsedDetails.Items}"
                                                  Visibility="{Binding HasWhereUsedItems, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryWhereUsedColumnParentPartNumber]}" Binding="{Binding ParentPartNumber}" Width="*"/>
                                                <DataGridTextColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryWhereUsedColumnParentName]}" Binding="{Binding ParentPartName}" Width="*"/>
                                                <DataGridTextColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryWhereUsedColumnParentRevision]}" Binding="{Binding ParentRevision}" Width="70"/>
                                                <DataGridTextColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryWhereUsedColumnParentState]}" Binding="{Binding ParentState}" Width="*"/>
                                                <DataGridTextColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryWhereUsedColumnQuantity]}" Binding="{Binding Quantity}" Width="60"/>
                                                <DataGridTextColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryWhereUsedColumnSource]}" Binding="{Binding Source}" Width="80"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryWhereUsedNoRecords]}"
                                                   Margin="8"
                                                   Foreground="{StaticResource LibraryMutedBrush}"
                                                   Visibility="{Binding HasNoWhereUsedItems, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource LibraryCardStyle}" Padding="18" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryPrimaryCadTitle]}" FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource LibraryTextBrush}"/>
                            <Border Margin="0,12,0,0" Padding="10" CornerRadius="8"
                                    Background="#F7FAFF" BorderBrush="#E0E8F5" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="26" Height="26" CornerRadius="7" Background="#EAF2FF"
                                            VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons" FontSize="13"
                                                   Foreground="{StaticResource LibraryPrimaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedEntryDetails.PrimaryCadFileName}"
                                               TextWrapping="Wrap" FontWeight="SemiBold"
                                               Foreground="{StaticResource LibraryTextBrush}"/>
                                </Grid>
                            </Border>
                            <UniformGrid Columns="2" Margin="0,12,0,0">
                                <Button Style="{StaticResource LibraryButtonStyle}" Margin="0,0,5,0"
                                        Command="{Binding OpenInIronCadCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8A7;" FontFamily="Segoe Fluent Icons" Margin="0,0,7,0"/>
                                        <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryOpenInIronCad]}"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource LibraryButtonStyle}" Margin="5,0,0,0"
                                        Command="{Binding OpenSelectedCadInArasCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE774;" FontFamily="Segoe Fluent Icons" Margin="0,0,7,0"/>
                                        <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryCadButtonOpenInAras]}"/>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                            <Button Style="{StaticResource LibraryButtonStyle}" Margin="0,10,0,0"
                                    Command="{Binding DownloadCadCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons" Margin="0,0,7,0"/>
                                    <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryDownloadCad]}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource LibraryPrimaryButtonStyle}" Margin="0,10,0,0" Height="44"
                                    Command="{Binding AddToCurrentProjectCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" Margin="0,0,7,0"/>
                                    <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryAddToProject]}"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding AddToProjectHint}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource LibraryMutedBrush}"
                                       FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource LibraryCardStyle}" Padding="18" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryQuickActionsTitle]}" FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource LibraryTextBrush}"/>
                            <UniformGrid Columns="1" Margin="0,10,0,0">
                                <Button Style="{StaticResource LibraryButtonStyle}" Margin="0,0,0,8" Height="38"
                                        Command="{Binding ViewWhereUsedCommand}" Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryViewWhereUsed]}"/>
                                <Button Style="{StaticResource LibraryButtonStyle}" Margin="0,0,0,8" Height="38"
                                        Command="{Binding ShowRevisionBrowserCommand}" Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryButtonRevisionBrowser]}"/>
                                <Button Style="{StaticResource LibraryButtonStyle}" Margin="0,0,0,8" Height="38"
                                        Command="{Binding MoveEntryCommand}" Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryButtonMoveEntry]}"/>
                                <Button Style="{StaticResource LibraryButtonStyle}" Margin="0,0,0,8" Height="38"
                                        Command="{Binding PinRevisionCommand}" Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryPinCurrentRevision]}"/>
                                <Button Style="{StaticResource LibraryButtonStyle}" Margin="0,0,0,8" Height="38"
                                        Command="{Binding UseLatestReleasedCommand}" Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryUseLatestReleased]}"/>
                                <Button Style="{StaticResource LibraryButtonStyle}" Margin="0,0,0,8" Height="38"
                                        Command="{Binding PublishCommand}" Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryPublishEntry]}"/>
                                <Button Style="{StaticResource LibraryButtonStyle}" Margin="0,0,0,8" Height="38"
                                        Command="{Binding DeprecateCommand}" Foreground="#B91C1C" Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryDeprecateEntry]}"/>
                                <Button Style="{StaticResource LibraryButtonStyle}" Margin="0" Height="38"
                                        Command="{Binding RemoveEntryCommand}" Foreground="#B91C1C" Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryRemoveEntry]}"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="3" Background="White" BorderBrush="#E5EBF3" BorderThickness="0,1,0,0" Padding="24,7">
            <Grid>
                <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryFooter]}" FontSize="11"
                           Foreground="{StaticResource LibraryMutedBrush}"/>
                <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Center" FontSize="11"
                           Foreground="{StaticResource LibraryMutedBrush}"/>
                <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryFooterVersion]}" HorizontalAlignment="Right" FontSize="11"
                           Foreground="{StaticResource LibraryMutedBrush}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
