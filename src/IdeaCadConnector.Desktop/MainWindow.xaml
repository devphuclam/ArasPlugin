<Window x:Class="IdeaCadConnector.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:IdeaCadConnector.Desktop"
        xmlns:core="clr-namespace:IdeaCadConnector.Core.Localization;assembly=IdeaCadConnector.Core"
        Title="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[Title]}"
        Width="1560"
        Height="980"
        MinWidth="1180"
        MinHeight="760"
        Background="#FFF4F7FC"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        SizeChanged="OnWindowSizeChanged">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Offset="0" Color="#FFF8FBFF" />
      <GradientStop Offset="0.55" Color="#FFF6F8FD" />
      <GradientStop Offset="1" Color="#FFF2F5FB" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SidebarActiveBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Offset="0" Color="#FFEEF5FF" />
      <GradientStop Offset="1" Color="#FFD7E8FF" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PrimaryActionBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Offset="0" Color="#FF1A6BFF" />
      <GradientStop Offset="1" Color="#FF2756EC" />
    </LinearGradientBrush>

    <Style x:Key="AppCardStyle" TargetType="Border">
      <Setter Property="Background" Value="#FEFFFFFF" />
      <Setter Property="BorderBrush" Value="#1A9AB3D5" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Padding" Value="20" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect BlurRadius="24" ShadowDepth="0" Color="#162C4C7A" Opacity="0.12" />
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SidebarButtonStyle" TargetType="Button">
      <Setter Property="Height" Value="52" />
      <Setter Property="Margin" Value="0,0,0,10" />
      <Setter Property="Padding" Value="18,0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#FF1B2B55" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonChrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="14">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonChrome" Property="Background" Value="#FFF2F7FF" />
                <Setter Property="BorderBrush" Value="#5590B8FF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonChrome" Property="Background" Value="#FFE3EEFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
      <Setter Property="Height" Value="42" />
      <Setter Property="Padding" Value="18,0" />
      <Setter Property="Background" Value="{StaticResource PrimaryActionBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#00000000" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonChrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="12">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.94" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.86" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
      <Setter Property="Background" Value="#FFFFFFFF" />
      <Setter Property="Foreground" Value="#FF23345D" />
      <Setter Property="BorderBrush" Value="#3392A9D4" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
      <Setter Property="Background" Value="#FFF8FBFF" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#FF1A2752" />
    </Style>

    <Style x:Key="MetaLabelStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#FF66708D" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="MetaValueStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Foreground" Value="#FF1D2B53" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SidebarFooterCardStyle" TargetType="Border" BasedOn="{StaticResource AppCardStyle}">
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="CornerRadius" Value="16" />
    </Style>

    <Style x:Key="SidebarFooterLabelStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#FF6A7894" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="TextInputStyle" TargetType="TextBox">
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="#FF1F2D57" />
      <Setter Property="Background" Value="#FFFFFFFF" />
      <Setter Property="BorderBrush" Value="#66A2B7DC" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="12">
              <ScrollViewer x:Name="PART_ContentHost" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Border" Property="BorderBrush" Value="#FF4E87FF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ComboBoxToggleButtonStyle" TargetType="ToggleButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="ClickMode" Value="Press" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="14">
              <Grid>
                <TextBlock HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="0,0,13,0"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="11"
                           Foreground="#FF6D7C96"
                           Text="&#xE70D;" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#FFF7FAFF" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FF9FB9EA" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FF4E87FF" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.65" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
      <Setter Property="Height" Value="42" />
      <Setter Property="Padding" Value="14,0,36,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="#FFFCFDFF" />
      <Setter Property="BorderBrush" Value="#C5D5E8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="#FF1F2D57" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="MaxDropDownHeight" Value="280" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="DropDownToggle"
                            Style="{StaticResource ComboBoxToggleButtonStyle}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
              <ContentPresenter x:Name="ContentSite"
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                IsHitTestVisible="False"
                                RecognizesAccessKey="True" />
              <Popup x:Name="PART_Popup"
                     AllowsTransparency="True"
                     Focusable="False"
                     IsOpen="{TemplateBinding IsDropDownOpen}"
                     Placement="Bottom"
                     PopupAnimation="Slide">
                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                        Margin="0,6,0,0"
                        Background="#FEFFFFFF"
                        BorderBrush="#FFD8E2F0"
                        BorderThickness="1"
                        CornerRadius="14"
                        Effect="{DynamicResource ComboBoxDropShadow}">
                  <ScrollViewer Margin="4"
                                CanContentScroll="True"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="DropDownToggle" Property="BorderBrush" Value="#FF4E87FF" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.65" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="Foreground" Value="#FF1F2D57" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ItemChrome"
                    Margin="4,2"
                    Padding="{TemplateBinding Padding}"
                    CornerRadius="10"
                    Background="{TemplateBinding Background}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemChrome" Property="Background" Value="#FFEAF2FF" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemChrome" Property="Background" Value="#FFDDEBFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DropShadowEffect x:Key="ComboBoxDropShadow"
                      BlurRadius="16"
                      ShadowDepth="0"
                      Color="#162C4C7A"
                      Opacity="0.18" />

    <Style x:Key="DataGridStyle" TargetType="DataGrid">
      <Setter Property="AutoGenerateColumns" Value="False" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HorizontalGridLinesBrush" Value="#1A8EA7D5" />
      <Setter Property="VerticalGridLinesBrush" Value="#00FFFFFF" />
      <Setter Property="CanUserAddRows" Value="False" />
      <Setter Property="CanUserDeleteRows" Value="False" />
      <Setter Property="CanUserResizeRows" Value="False" />
      <Setter Property="CanUserSortColumns" Value="False" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="RowHeaderWidth" Value="0" />
      <Setter Property="SelectionMode" Value="Single" />
      <Setter Property="AlternatingRowBackground" Value="#FFFCFDFF" />
      <Setter Property="RowBackground" Value="White" />
      <Setter Property="BorderBrush" Value="#00000000" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Height" Value="42" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Background" Value="#FFF7FAFF" />
      <Setter Property="Foreground" Value="#FF23345D" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderBrush" Value="#1A8EA7D5" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style TargetType="DataGridRow">
      <Setter Property="Height" Value="44" />
      <Setter Property="Foreground" Value="#FF1F2D57" />
      <Setter Property="BorderThickness" Value="0" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#FFEAF2FF" />
          <Setter Property="Foreground" Value="#FF1740A6" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="Transparent" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Border Background="{StaticResource AppBackgroundBrush}">
    <Grid x:Name="RootGrid">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="SidebarColumn" Width="232" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              Background="#F9FFFFFF"
              BorderBrush="#1A9AB3D5"
              BorderThickness="0,0,1,0">
        <Grid Margin="12,16,12,18">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal" Margin="8,2,8,18">
              <Border Width="28" Height="28" CornerRadius="8">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#FF41D7FF" />
                    <GradientStop Offset="1" Color="#FF2E6FFF" />
                  </LinearGradientBrush>
                </Border.Background>
                <Grid>
                  <Rectangle Width="7" Height="7" RadiusX="1.5" RadiusY="1.5" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,6,0,0" />
                  <Rectangle Width="7" Height="7" RadiusX="1.5" RadiusY="1.5" Fill="White" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" />
                  <Rectangle Width="7" Height="7" RadiusX="1.5" RadiusY="1.5" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6,0,0,6" />
                  <Rectangle Width="7" Height="7" RadiusX="1.5" RadiusY="1.5" Fill="White" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6" />
                </Grid>
              </Border>
               <TextBlock Margin="12,0,0,0"
                          VerticalAlignment="Center"
                          FontSize="16"
                          FontWeight="Medium"
                          Foreground="#FF1B274A"
                          Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[Title]}" />
            </StackPanel>

            <Button x:Name="HomeNavigationButton"
                    Style="{StaticResource SidebarButtonStyle}"
                    Background="{StaticResource SidebarActiveBrush}"
                    BorderBrush="#3390B8FF"
                    Click="OnHomeNavigationClick">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="32" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock FontFamily="Segoe MDL2 Assets"
                           FontSize="18"
                           Foreground="#FF1D63E7"
                           VerticalAlignment="Center"
                           Text="&#xE80F;" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#FF1D63E7"
                           Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[SidebarHome]}" />
              </Grid>
            </Button>

            <Button x:Name="SearchNavigationButton"
                    Style="{StaticResource SidebarButtonStyle}"
                    Click="OnSearchNavigationClick">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="32" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" Text="&#xE721;" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="15" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[SidebarSearch]}" />
              </Grid>
            </Button>

            <Button Style="{StaticResource SidebarButtonStyle}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="32" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" Text="&#xE823;" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="15" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[SidebarRecent]}" />
              </Grid>
            </Button>

            <Button Style="{StaticResource SidebarButtonStyle}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="32" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" Text="&#xE734;" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="15" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[SidebarFavorites]}" />
              </Grid>
            </Button>

            <Button x:Name="PdmProjectsNavigationButton"
                    Style="{StaticResource SidebarButtonStyle}"
                    Click="OnPdmProjectsNavigationClick">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="32" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" Text="&#xE8A5;" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="15" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[SidebarPdmProjects]}" />
              </Grid>
            </Button>

            <Button x:Name="LibraryNavigationButton"
                    Style="{StaticResource SidebarButtonStyle}"
                    Click="OnLibraryNavigationClick">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="32" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" Text="&#xE8F1;" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="15" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LibraryTitle]}" />
              </Grid>
            </Button>

            <Button Style="{StaticResource SidebarButtonStyle}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="32" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" Text="&#xE8B7;" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="15" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[SidebarProjects]}" />
              </Grid>
            </Button>

            <Button Style="{StaticResource SidebarButtonStyle}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="32" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" Text="&#xE9D2;" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="15" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[SidebarReports]}" />
              </Grid>
            </Button>

            <Button Style="{StaticResource SidebarButtonStyle}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="32" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" Text="&#xE713;" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="15" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[SidebarSettings]}" />
              </Grid>
            </Button>

            <Button Style="{StaticResource SidebarButtonStyle}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="32" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" Text="&#xE897;" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="15" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[SidebarAbout]}" />
              </Grid>
            </Button>
          </StackPanel>

          <StackPanel Grid.Row="2">
            <Border Style="{StaticResource SidebarFooterCardStyle}"
                    Margin="0,0,0,12"
                    CornerRadius="14">
              <StackPanel>
                <TextBlock Style="{StaticResource SidebarFooterLabelStyle}"
                           Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[SidebarTheme]}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock FontFamily="Segoe MDL2 Assets"
                             VerticalAlignment="Center"
                             Foreground="#FF3E6FD9"
                             Text="&#xE706;" />
                  <TextBlock Grid.Column="1"
                             VerticalAlignment="Center"
                             Foreground="#FF1D2B53"
                             FontWeight="SemiBold"
                             Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[SidebarTheme]}" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource SidebarFooterCardStyle}"
                    Margin="0,0,0,12"
                    CornerRadius="14">
              <StackPanel>
                <TextBlock Style="{StaticResource SidebarFooterLabelStyle}"
                           Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[SidebarLanguage]}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock FontFamily="Segoe MDL2 Assets"
                             VerticalAlignment="Center"
                             Foreground="#FF3E6FD9"
                             Text="&#xF2B7;" />
                  <ComboBox Grid.Column="1"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Height="38"
                            FontSize="13"
                            Style="{StaticResource ComboBoxStyle}"
                            ItemsSource="{Binding LanguageOptions}"
                            SelectedValuePath="CultureName"
                            SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}"
                                   TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
              </StackPanel>
            </Border>

            <Button x:Name="SidebarCollapseButton"
                    Style="{StaticResource SidebarButtonStyle}"
                    Margin="0"
                    Click="OnSidebarCollapseClick">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="32" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SidebarCollapseIcon"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="18"
                           VerticalAlignment="Center"
                           Text="&#xE76B;" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           FontSize="15"
                           Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[SidebarCollapse]}" />
              </Grid>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="54" />
          <RowDefinition Height="*" />
          <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#F8FFFFFF"
                BorderBrush="#149AB3D5"
                BorderThickness="0,0,0,1">
          <Grid Margin="18,0,18,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="260" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       FontSize="13"
                       Foreground="#FF7A879F"
                       HorizontalAlignment="Right"
                       Text="" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

            </StackPanel>
          </Grid>
        </Border>

        <ScrollViewer x:Name="ExistingWorkspace"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <Grid Margin="20">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource AppCardStyle}"
                    Margin="0,0,0,14"
                    Padding="26,22">
              <Grid x:Name="HeaderGrid">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                  <TextBlock FontSize="54"
                             FontWeight="Bold"
                             Foreground="#FF122A63"
                             Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[HeaderTitle]}" />
                  <TextBlock Margin="0,4,0,0"
                             FontSize="21"
                             Foreground="#FF5E6D8B"
                             Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[HeaderSubtitle]}" />
                </StackPanel>

                <Border Grid.Column="1"
                        Style="{StaticResource AppCardStyle}"
                        Padding="16"
                        CornerRadius="16"
                        VerticalAlignment="Center">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="42" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="24" />
                    </Grid.ColumnDefinitions>
                    <Border Width="38"
                            Height="38"
                            CornerRadius="19"
                            Background="#FF1FA64A"
                            VerticalAlignment="Center">
                      <TextBlock FontFamily="Segoe MDL2 Assets"
                                 FontSize="18"
                                 Foreground="White"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Text="&#xE73E;" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                      <TextBlock FontSize="14"
                                 FontWeight="SemiBold"
                                 Foreground="#FF16274F"
                                 Text="{Binding ConnectedUserText}" />
                      <TextBox Margin="0,4,0,0"
                               FontSize="13"
                               Foreground="#FF60708E"
                               Text="{Binding StatusMessage}"
                               IsReadOnly="True"
                               BorderThickness="0"
                               Background="Transparent"
                               TextWrapping="Wrap"
                               IsTabStop="False" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            Width="32" Height="32"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[SignOutTooltip]}"
                            Command="{Binding LogoutCommand}">
                      <TextBlock FontFamily="Segoe MDL2 Assets"
                                 FontSize="15"
                                 Foreground="#FF344B84"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Center"
                                 Text="&#xE711;" />
                    </Button>
                  </Grid>
                </Border>
              </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="0,0,0,14">
              <Border Style="{StaticResource AppCardStyle}"
                      Margin="0,0,0,14"
                      Visibility="{Binding IsLoginPanelVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid x:Name="LoginGrid">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#FF25355D" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LoginLabelUser]}" />
                  <TextBox Grid.Column="1"
                           Margin="0,0,14,0"
                           Style="{StaticResource TextInputStyle}"
                           Text="{Binding LoginViewModel.UserName, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#FF25355D" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LoginLabelPassword]}" />
                  <Border Grid.Column="3"
                          Margin="0,0,14,0"
                          Height="40"
                          CornerRadius="12"
                          Background="White"
                          BorderBrush="#66A2B7DC"
                          BorderThickness="1">
                    <PasswordBox x:Name="PasswordInput"
                                 VerticalContentAlignment="Center"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 PasswordChanged="OnPasswordChanged" />
                  </Border>
                  <Button Grid.Column="4"
                          Width="116"
                          Style="{StaticResource PrimaryButtonStyle}"
                          Command="{Binding LoginCommand}"
                          Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[LoginButton]}" />
                  <TextBlock Grid.Column="5"
                             Margin="16,0,0,0"
                             VerticalAlignment="Center"
                             Foreground="#FFB42318"
                             Text="{Binding LoginViewModel.ErrorMessage}"
                             TextWrapping="Wrap" />
                </Grid>
              </Border>

              <Border Style="{StaticResource AppCardStyle}" Padding="22,18">
                <Grid x:Name="SearchGrid">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <Border Grid.Column="0"
                          Width="52"
                          Height="52"
                          Margin="0,0,14,0"
                          CornerRadius="18"
                          Background="#FFEAF2FF"
                          VerticalAlignment="Center">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="24"
                               Foreground="#FF2967EF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Text="&#xE721;" />
                  </Border>

                  <StackPanel Grid.Column="1">
                    <TextBlock Margin="0,0,0,8"
                               Style="{StaticResource SectionTitleStyle}"
                               Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartSearchLabel]}" />
                    <TextBox Style="{StaticResource TextInputStyle}"
                             Text="{Binding LoginViewModel.SearchKeyword, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>

                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="14,0,0,0">
                    <Button Width="92"
                            Margin="0,0,12,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding SearchPartsCommand}"
                            Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[SearchButton]}" />
                    <TextBlock VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="#FF60708E"
                               Text="{Binding LoginViewModel.SearchStatusMessage}" />
                  </StackPanel>

                  <Button Grid.Column="3"
                          Width="126"
                          Height="42"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Bottom"
                          Style="{StaticResource SecondaryButtonStyle}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                      <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71C;" />
                      <TextBlock Margin="8,0,8,0" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[FiltersButton]}" />
                      <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70D;" />
                    </StackPanel>
                  </Button>
                </Grid>
              </Border>
            </StackPanel>

            <Grid Grid.Row="2" x:Name="MainContentGrid">
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.55*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="1.18*" />
              </Grid.ColumnDefinitions>

              <Border Grid.Row="0"
                      Grid.Column="0"
                      Style="{StaticResource AppCardStyle}"
                      x:Name="ResultsCard"
                      Padding="22">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <DockPanel Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel DockPanel.Dock="Left">
                      <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartResultsLabel]}" />
                      <TextBlock Margin="0,6,0,0"
                                 FontSize="14"
                                 Foreground="#FF60708E"
                                 Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartResultsSubtitle]}" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                      <Button Width="44" Height="38" Margin="0,0,10,0" Style="{StaticResource PrimaryButtonStyle}">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="15" Text="&#xE8FD;" />
                      </Button>
                      <Button Width="44" Height="38" Style="{StaticResource SecondaryButtonStyle}">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="15" Text="&#xECA5;" />
                      </Button>
                    </StackPanel>
                  </DockPanel>

                  <Border Grid.Row="1"
                          BorderBrush="#1A8EA7D5"
                          BorderThickness="1"
                          CornerRadius="16"
                          Background="#FFFFFFFF"
                          Padding="0">
                    <DataGrid Style="{StaticResource DataGridStyle}"
                              ItemsSource="{Binding LoginViewModel.SearchResults}"
                              SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}">
                      <DataGrid.Columns>
                        <DataGridTemplateColumn Width="170" Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[ColumnPartNumber]}">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <TextBlock VerticalAlignment="Center"
                                         FontWeight="SemiBold"
                                         Foreground="#FF1E5BEB"
                                         Text="{Binding Part.PartNumber}" />
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Width="220" Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[ColumnPartName]}" Binding="{Binding Part.Name}" />
                        <DataGridTextColumn Width="72" Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[ColumnPartRev]}" Binding="{Binding Part.Revision}" />
                        <DataGridTemplateColumn Width="160" Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[ColumnState]}">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                              <Border Padding="10,4" CornerRadius="12" Background="#FFF4F7FB">
                                  <Border.Style>
                                    <Style TargetType="Border">
                                      <Setter Property="Background" Value="#FFF4F7FB" />
                                      <Style.Triggers>
                                        <DataTrigger Binding="{Binding Part.State}" Value="Preliminary">
                                          <Setter Property="Background" Value="#FFE9F0FF" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Part.State}" Value="Obsolete">
                                          <Setter Property="Background" Value="#FFF0F2F5" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Part.State}" Value="Khoi tao">
                                          <Setter Property="Background" Value="#FFFFF1E6" />
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </Border.Style>
                                  <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Part.State}">
                                    <TextBlock.Style>
                                      <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FF5F6D86" />
                                        <Style.Triggers>
                                          <DataTrigger Binding="{Binding Part.State}" Value="Preliminary">
                                            <Setter Property="Foreground" Value="#FF285CE8" />
                                          </DataTrigger>
                                          <DataTrigger Binding="{Binding Part.State}" Value="Khoi tao">
                                            <Setter Property="Foreground" Value="#FFF08A24" />
                                          </DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </TextBlock.Style>
                                  </TextBlock>
                                </Border>
                              </StackPanel>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="128" Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[ColumnType]}">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <Border VerticalAlignment="Center" Padding="10,4" CornerRadius="12">
                                <Border.Style>
                                  <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FFF4EDFF" />
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding Part.PartType}" Value="Assembly">
                                        <Setter Property="Background" Value="#FFE7F8EA" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </Border.Style>
                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Part.PartType}">
                                  <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                      <Setter Property="Foreground" Value="#FF7C47DC" />
                                      <Style.Triggers>
                                        <DataTrigger Binding="{Binding Part.PartType}" Value="Assembly">
                                          <Setter Property="Foreground" Value="#FF1F8D4D" />
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </TextBlock.Style>
                                </TextBlock>
                              </Border>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Width="140" Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[ColumnCadNumber]}" Binding="{Binding IronCadPartCad.CadNumber}" />
                      </DataGrid.Columns>
                    </DataGrid>
                  </Border>

                  <Grid Grid.Row="2" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="#FF60708E"
                               Text="{Binding LoginViewModel.SearchStatusMessage}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                      <Button Width="34" Height="34" Margin="0,0,10,0"
                              Style="{StaticResource SecondaryButtonStyle}"
                              Command="{Binding PreviousPageCommand}">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE76B;" />
                      </Button>
                      <Border MinWidth="34"
                              Height="34"
                              Padding="12,0"
                              Background="{StaticResource PrimaryActionBrush}"
                              CornerRadius="10">
                        <TextBlock VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   Text="{Binding CurrentPage}" />
                      </Border>
                      <Button Width="34" Height="34" Margin="10,0,0,0"
                              Style="{StaticResource SecondaryButtonStyle}"
                              Command="{Binding NextPageCommand}">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE76C;" />
                      </Button>
                    </StackPanel>
                  </Grid>
                </Grid>
              </Border>

              <StackPanel Grid.Row="0" Grid.Column="2" x:Name="DetailsPanel">
                <Border Style="{StaticResource AppCardStyle}"
                        Margin="0,0,0,14"
                        BorderBrush="#55C287FF">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,16">
                      <TextBlock DockPanel.Dock="Left"
                                  Style="{StaticResource SectionTitleStyle}"
                                  Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[SelectedPartLabel]}" />
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Width="32" Height="32" Margin="0,0,8,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Command="{Binding ToggleFavoriteCommand}">
                          <TextBlock FontFamily="Segoe MDL2 Assets"
                                     FontSize="18"
                                     Foreground="#FF394F87"
                                     Text="&#xE734;" />
                        </Button>
                        <Button Width="32" Height="32"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Command="{Binding ViewPartDetailsCommand}">
                          <TextBlock FontFamily="Segoe MDL2 Assets"
                                     FontSize="18"
                                     Foreground="#FF394F87"
                                     Text="&#xE712;" />
                        </Button>
                      </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="1">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="82" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>

                      <Border Width="78"
                              Height="78"
                              CornerRadius="22">
                        <Border.Background>
                          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="#FFC189FF" />
                            <GradientStop Offset="1" Color="#FF7D4EFF" />
                          </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="36"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="&#xE8FD;" />
                      </Border>

                      <StackPanel Grid.Column="1" Margin="16,2,0,0">
                        <TextBlock FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="#FF16274F"
                                   Text="{Binding SelectedSearchResult.Part.PartNumber, TargetNullValue=No part selected}" />
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="14"
                                   Foreground="#FF60708E"
                                   Text="{Binding SelectedSearchResult.Part.Name, TargetNullValue=Select one part from the table}" />

                        <Grid Margin="0,18,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>

                          <TextBlock Grid.Row="0" Style="{StaticResource MetaLabelStyle}" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[MetaRevision]}" />
                          <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource MetaValueStyle}" Text="{Binding SelectedSearchResult.Part.Revision, TargetNullValue=-}" />
                          <TextBlock Grid.Row="1" Style="{StaticResource MetaLabelStyle}" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[MetaState]}" />
                          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" Margin="0,5,10,0" Fill="#FF2E63FF" />
                            <TextBlock Style="{StaticResource MetaValueStyle}" Text="{Binding SelectedSearchResult.Part.State, TargetNullValue=-}" />
                          </StackPanel>
                          <TextBlock Grid.Row="2" Style="{StaticResource MetaLabelStyle}" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[MetaType]}" />
                          <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource MetaValueStyle}" Foreground="#FF6D46D9" Text="{Binding SelectedSearchResult.Part.PartType, TargetNullValue=-}" />
                          <TextBlock Grid.Row="3" Style="{StaticResource MetaLabelStyle}" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[MetaDescription]}" />
                          <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource MetaValueStyle}" Text="{Binding SelectedSearchResult.Part.Description, TargetNullValue=-}" />
                        </Grid>
                      </StackPanel>
                    </Grid>
                  </Grid>
                </Border>

                <Border Style="{StaticResource AppCardStyle}"
                        Margin="0,0,0,14"
                        BorderBrush="#55A7F0D7">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                      <TextBlock DockPanel.Dock="Left"
                                  Style="{StaticResource SectionTitleStyle}"
                                  Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[SelectedCadLabel]}" />
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Border Padding="10,4"
                                Margin="0,0,8,0"
                                Background="#FFF4F7FB"
                                CornerRadius="12"
                                BorderBrush="#1A8EA7D5"
                                BorderThickness="1">
                          <TextBlock FontSize="12"
                                     FontWeight="SemiBold"
                                     Foreground="#FF61718E"
                                     Text="{Binding CurrentCadFileStateText}" />
                        </Border>
                        <Border Padding="10,4"
                                Background="#FFF4F7FB"
                                CornerRadius="12"
                                BorderBrush="#1A8EA7D5"
                                BorderThickness="1">
                          <TextBlock FontSize="12"
                                     FontWeight="SemiBold"
                                     Foreground="#FF61718E"
                                     Text="{Binding CurrentCadLockStateText}" />
                        </Border>
                      </StackPanel>
                    </DockPanel>

                    <Grid Margin="0,0,0,12">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>

<TextBlock Grid.Row="0" Style="{StaticResource MetaLabelStyle}" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[SummaryCadRevision]}" />
                      <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource MetaValueStyle}" Text="{Binding SelectedSearchResult.IronCadPartCad.Revision, TargetNullValue=-}" />
                      <TextBlock Grid.Row="1" Style="{StaticResource MetaLabelStyle}" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[MetaState]}" />
                      <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource MetaValueStyle}" Text="{Binding SelectedSearchResult.IronCadPartCad.State, TargetNullValue=-}" />
                      <TextBlock Grid.Row="2" Style="{StaticResource MetaLabelStyle}" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[SummaryCadClassification]}" />
                      <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource MetaValueStyle}" Text="{Binding SelectedSearchResult.IronCadPartCad.Classification, TargetNullValue=-}" />
                      <TextBlock Grid.Row="3" Style="{StaticResource MetaLabelStyle}" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[MetricArasGeneration]}" />
                      <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource MetaValueStyle}" Text="{Binding SelectedSearchResult.IronCadPartCad.Generation, TargetNullValue=-}" />
                      <TextBlock Grid.Row="4" Style="{StaticResource MetaLabelStyle}" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[MetricLockedBy]}" />
                      <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource MetaValueStyle}" Text="{Binding SelectedSearchResult.IronCadPartCad.LockedBy, TargetNullValue=-}" />
                    </Grid>

                    <Border Background="#FFF4F9FF"
                            BorderBrush="#4FC1DDFF"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="14">
                      <StackPanel>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock FontFamily="Segoe MDL2 Assets"
                                     FontSize="15"
                                     Foreground="#FF2768F2"
                                     Text="&#xE946;" />
                          <TextBlock Margin="10,0,0,0"
                                     FontWeight="SemiBold"
                                     Foreground="#FF1A2A53"
                                     Text="{Binding CurrentCadStatusText}" />
                        </StackPanel>
                        <TextBlock Margin="26,6,0,0"
                                   Foreground="#FF60708E"
                                   Text="{Binding ActionHint}"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource AppCardStyle}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[MainActionsSection]}" />
                    <UniformGrid Columns="2" Margin="0,16,0,0">
                      <Button Margin="0,0,8,10"
                              Style="{StaticResource PrimaryButtonStyle}"
                              Command="{Binding SelectAndCreateCadCommand}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" />
                          <TextBlock Margin="8,0,0,0" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[MainSelectCreateCad]}" />
                        </StackPanel>
                      </Button>

                      <Button Margin="0,0,0,10"
                              Style="{StaticResource SecondaryButtonStyle}"
                              Command="{Binding OpenReadOnlyCommand}"
                              Visibility="{Binding HasOpenReadOnlyAction, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A7;" />
                          <TextBlock Margin="8,0,0,0" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[MainOpenReadOnly]}" />
                        </StackPanel>
                      </Button>

                      <Button Margin="0,0,8,10"
                              Style="{StaticResource SecondaryButtonStyle}"
                              Command="{Binding CheckoutCommand}"
                              Visibility="{Binding HasCheckoutAction, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72E;" />
                          <TextBlock Margin="8,0,0,0" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[MainCheckoutButton]}" />
                        </StackPanel>
                      </Button>

                      <Button Margin="0,0,0,10"
                              Style="{StaticResource PrimaryButtonStyle}"
                              Command="{Binding CheckInCommand}"
                              Visibility="{Binding HasCheckInAction, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE898;" />
                          <TextBlock Margin="8,0,0,0" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[MainCheckinButton]}" />
                        </StackPanel>
                      </Button>

                      <Button Margin="0"
                              Style="{StaticResource GhostButtonStyle}"
                              Command="{Binding CancelCheckoutCommand}"
                              Visibility="{Binding HasCancelCheckoutAction, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" />
                          <TextBlock Margin="8,0,0,0" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[MainCancelCheckoutButton]}" />
                        </StackPanel>
                      </Button>
                    </UniformGrid>

                    <Button Margin="0,14,0,0"
                            Height="36"
                            Background="#FF5A6B8A"
                            BorderBrush="#FF5A6B8A"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Command="{Binding StartNewRevisionCommand}"
                            Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[MainStartNewRevision]}"
                            Visibility="{Binding HasSearchRevisionEntryPoint, Converter={StaticResource BoolToVisibilityConverter}}"
                            ToolTip="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[MainStartNewRevisionTooltip]}" />

                    <Button Margin="0,10,0,0"
                            Height="36"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding AddSelectedPartToLibraryCommand}"
                            Visibility="{Binding HasAddSelectedPartToLibraryAction, Converter={StaticResource BoolToVisibilityConverter}}">
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" />
                        <TextBlock Margin="8,0,0,0" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[SaveToLibraryTitle]}" />
                      </StackPanel>
                    </Button>

                    <TextBlock Margin="0,6,0,0"
                               FontSize="11"
                               Foreground="#FF60708E"
                               TextWrapping="Wrap"
                               Text="{Binding SearchRevisionHint}"
                               Visibility="{Binding HasSearchRevisionHint, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <Border Margin="0,16,0,0"
                            Padding="14"
                            Background="#FFFDF8EC"
                            BorderBrush="#33E1BE70"
                            BorderThickness="1"
                            CornerRadius="14"
                            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}}">
                      <StackPanel>
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Left"
                                     FontSize="16"
                                     FontWeight="SemiBold"
                                     Foreground="#FF1A2752"
                                      Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[MainWorkflowSection]}" />
                          <Button DockPanel.Dock="Right"
                                  Width="92"
                                  Height="32"
                                  Style="{StaticResource SecondaryButtonStyle}"
                                  Command="{Binding RefreshWorkflowCommand}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" />
                              <TextBlock Margin="6,0,0,0" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[MainRefreshButton]}" />
                            </StackPanel>
                          </Button>
                        </DockPanel>

                        <TextBlock Margin="0,10,0,0"
                                   Foreground="#FF60708E"
                                   Text="{Binding WorkflowStatusText}"
                                   TextWrapping="Wrap" />

                        <UniformGrid Columns="2" Margin="0,12,0,0">
                          <Button Margin="0,0,8,8"
                                  Style="{StaticResource PrimaryButtonStyle}"
                                  Command="{Binding StartDetailedDesignCommand}"
                                  Visibility="{Binding HasStartDetailedDesignAction, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[MainStartDetailedDesign]}" />
                          </Button>
                          <Button Margin="0,0,0,8"
                                  Style="{StaticResource PrimaryButtonStyle}"
                                  Command="{Binding SubmitForReviewCommand}"
                                  Visibility="{Binding HasSubmitForReviewAction, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[MainSubmitForReview]}" />
                          </Button>
                          <Button Margin="0,0,8,0"
                                  Style="{StaticResource PrimaryButtonStyle}"
                                  Command="{Binding ApproveCommand}"
                                  Visibility="{Binding HasApproveAction, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[MainApprove]}" />
                          </Button>
                          <Button Margin="0,0,0,0"
                                  Style="{StaticResource SecondaryButtonStyle}"
                                  Command="{Binding RequestReworkCommand}"
                                  Visibility="{Binding HasRequestReworkAction, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[MainRequestRework]}" />
                          </Button>
                        </UniformGrid>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
          </Grid>
        </ScrollViewer>

        <ScrollViewer x:Name="PdmWorkspace"
                      Grid.Row="1"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
          <local:PdmProjectsView />
        </ScrollViewer>

        <Grid x:Name="LibraryWorkspace"
              Grid.Row="1"
              Visibility="Collapsed">
          <local:LibraryView />
        </Grid>

        <Grid Grid.Row="2" Margin="20,0,20,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock VerticalAlignment="Center"
                     FontSize="12"
                     Foreground="#FF7A879F"
                     Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[Title]}" />
          <TextBlock Grid.Column="1"
                     VerticalAlignment="Center"
                     FontSize="12"
                     Foreground="#FF7A879F"
                     Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[MainVersion]}" />
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
