<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>IdeaCadConnector.Desktop</RootNamespace>
    <AssemblyName>IdeaCadConnector.Desktop</AssemblyName>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\IdeaCadConnector.Core\IdeaCadConnector.Core.csproj" />
    <ProjectReference Include="..\IdeaCadConnector.Aras\IdeaCadConnector.Aras.csproj" />
    <ProjectReference Include="..\IdeaCadConnector.Workspace\IdeaCadConnector.Workspace.csproj" />
    <ProjectReference Include="..\IdeaCadConnector.Ui\IdeaCadConnector.Ui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Explicitly pull in Newtonsoft.Json so it is copied to output.
         It is consumed by HttpArasCadClient but the transitive copy from
         Aras.IOM is suppressed by ExcludeAssets=runtime. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <None Include="pdm-naming-policy.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    Desktop now uses ArasCadClient (IOM-based).
    The Aras.IOM NuGet package does not expose standard runtime assets for net48,
    so copy the supported runtime assembly and its supporting libraries explicitly.
  -->
  <ItemGroup>
    <None Include="$(NuGetPackageRoot)aras.iom\15.1.2\tools\net472\IOM.dll">
      <Link>IOM.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(NuGetPackageRoot)microsoft.bcl.timeprovider\8.0.1\lib\net462\Microsoft.Bcl.TimeProvider.dll">
      <Link>Microsoft.Bcl.TimeProvider.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(NuGetPackageRoot)system.text.encodings.web\8.0.0\lib\net462\System.Text.Encodings.Web.dll">
      <Link>System.Text.Encodings.Web.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(NuGetPackageRoot)system.valuetuple\4.5.0\lib\net47\System.ValueTuple.dll">
      <Link>System.ValueTuple.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
