<UserControl x:Class="IdeaCadConnector.Desktop.PdmProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:IdeaCadConnector.Desktop"
             MinWidth="1100"
             Background="Transparent">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

    <Style x:Key="TopNavTabStyle" TargetType="TabItem">
      <Setter Property="Foreground" Value="#FF52627F" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Chrome"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0,0,0,2"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FF2967EF" />
                <Setter Property="Foreground" Value="#FF174FCB" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BadgeTextStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#FF174FCB" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="MetricValueStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#FF172B57" />
    </Style>

    <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#FF677892" />
    </Style>

    <Style x:Key="GhostToolbarTextStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#FF405173" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,18,0" />
    </Style>

    <HierarchicalDataTemplate DataType="{x:Type local:PdmStructureNode}"
                              ItemsSource="{Binding Children}">
      <Grid Height="44" MinWidth="340">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="96" />
          <ColumnDefinition Width="70" />
          <ColumnDefinition Width="42" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="22"
                  Height="22"
                  Margin="0,0,10,0"
                  CornerRadius="6"
                  Background="{Binding Accent}">
            <TextBlock FontFamily="Segoe MDL2 Assets"
                       FontSize="12"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Text="&#xE8FD;" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#FF1B2B55"
                       Text="{Binding Name}" />
            <TextBlock FontSize="10"
                       Foreground="#FF7A879F"
                       Text="{Binding PartCode}" />
          </StackPanel>
        </StackPanel>

        <Border Grid.Column="1"
                Margin="8,0"
                Padding="10,4"
                CornerRadius="8"
                Background="#FFF1ECFF"
                VerticalAlignment="Center">
          <TextBlock HorizontalAlignment="Center"
                     FontSize="11"
                     FontWeight="SemiBold"
                     Foreground="{Binding Accent}"
                     Text="{Binding NodeType}" />
        </Border>

        <TextBlock Grid.Column="2"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   FontSize="13"
                   Foreground="#FF203054"
                   Text="{Binding Quantity}" />

        <Ellipse Grid.Column="3"
                 Width="12"
                 Height="12"
                 Fill="#FF13A444"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Center" />
      </Grid>
    </HierarchicalDataTemplate>

    <HierarchicalDataTemplate DataType="{x:Type local:PdmProjectFileNode}"
                              ItemsSource="{Binding Children}">
      <Grid Height="32" MinWidth="280">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="90" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock FontSize="12" Foreground="#FF1B2B55" Text="{Binding Name}" />
          <TextBlock FontSize="10" Foreground="#FF7A879F" Text="{Binding RelativePath}" />
        </StackPanel>
        <TextBlock Grid.Column="1"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   FontSize="11"
                   Foreground="#FF60708E"
                   Text="{Binding Kind}" />
      </Grid>
    </HierarchicalDataTemplate>

    <Style x:Key="CardHeaderButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    BorderBrush="{TemplateBinding BorderBrush}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="4,0,4,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="320" />
      </Grid.ColumnDefinitions>

      <StackPanel>
        <TextBlock FontSize="42"
                   FontWeight="Bold"
                   Foreground="#FF122A63"
                   Text="PDM Projects" />
        <TextBlock Margin="0,4,0,0"
                   FontSize="16"
                   Foreground="#FF5E6D8B"
                   Text="Version project files and product structure in Aras Innovator." />
      </StackPanel>

      <Border Grid.Column="1"
              Style="{DynamicResource AppCardStyle}"
              Padding="16"
              VerticalAlignment="Center">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
          </Grid.ColumnDefinitions>
          <Border Width="40" Height="40" CornerRadius="20" Background="#FF1FA64A">
            <TextBlock FontFamily="Segoe MDL2 Assets"
                       FontSize="18"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Text="&#xE73E;" />
          </Border>
          <StackPanel Grid.Column="1" Margin="12,0,0,0">
            <TextBlock FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#FF1B2B55"
                       Text="{Binding ConnectionDisplayName}" />
            <TextBlock Margin="0,4,0,0"
                       FontSize="12"
                       Foreground="#FF60708E"
                       Text="{Binding ConnectionDatabase}" />
          </StackPanel>
          <TextBlock Grid.Column="2"
                     FontFamily="Segoe MDL2 Assets"
                     FontSize="12"
                     Foreground="#FF25355D"
                     VerticalAlignment="Center"
                     Text="&#xE70D;" />
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="1"
            Style="{DynamicResource AppCardStyle}"
            Margin="0,0,0,16"
            Padding="18">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2.4*" />
          <ColumnDefinition Width="1.4*" />
          <ColumnDefinition Width="2.6*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,12,0">
          <TextBlock Margin="4,0,0,6" FontSize="12" Foreground="#FF60708E" Text="Repository" />
          <ComboBox Height="40"
                    ItemsSource="{Binding Repositories}"
                    SelectedItem="{Binding SelectedRepository}"
                    Style="{DynamicResource TextInputComboStyle}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="0,0,12,0">
          <TextBlock Margin="4,0,0,6" FontSize="12" Foreground="#FF60708E" Text="Branch" />
          <DockPanel>
            <ComboBox Height="40"
                      Width="150"
                      ItemsSource="{Binding Branches}"
                      SelectedItem="{Binding SelectedBranch}"
                      Style="{DynamicResource TextInputComboStyle}" />
            <Border Margin="8,0,0,0"
                    Padding="10,0"
                    Height="28"
                    VerticalAlignment="Center"
                    CornerRadius="8"
                    Background="#FFF0F5FF">
              <TextBlock Style="{StaticResource BadgeTextStyle}" Text="MAIN" />
            </Border>
          </DockPanel>
        </StackPanel>

        <StackPanel Grid.Column="2" Margin="0,0,12,0">
          <TextBlock Margin="4,0,0,6" FontSize="12" Foreground="#FF60708E" Text="Commit" />
          <ComboBox Height="40"
                    ItemsSource="{Binding Commits}"
                    SelectedItem="{Binding SelectedCommit}"
                    Style="{DynamicResource TextInputComboStyle}" />
        </StackPanel>

        <Button Grid.Column="3"
                Margin="0,20,10,0"
                Height="40"
                MinWidth="92"
                Style="{DynamicResource SecondaryButtonStyle}"
                Command="{Binding BrowseFolderCommand}"
                Content="Browse" />
        <Button Grid.Column="4"
                Margin="0,20,10,0"
                Height="40"
                MinWidth="92"
                Style="{DynamicResource SecondaryButtonStyle}"
                Command="{Binding AnalyzeFolderCommand}"
                Content="Analyze" />
        <Button Grid.Column="5"
                Margin="0,20,0,0"
                Height="40"
                MinWidth="92"
                Style="{DynamicResource PrimaryButtonStyle}"
                Command="{Binding PushCommand}"
                Content="Push" />

        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   VerticalAlignment="Center"
                   Margin="4,14,0,0"
                   FontSize="12"
                   Foreground="#FF60708E"
                   Text="Project folder" />
        <TextBox Grid.Row="1"
                 Grid.Column="0"
                 Grid.ColumnSpan="3"
                 Margin="92,12,0,0"
                 Height="38"
                 Style="{DynamicResource TextInputStyle}"
                 Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Grid.Row="2"
                   Grid.ColumnSpan="6"
                   Margin="0,14,0,0"
                   FontSize="13"
                   Foreground="#FF60708E"
                   TextWrapping="Wrap"
                   Text="{Binding AnalysisSummary}" />
      </Grid>
    </Border>

    <Grid Grid.Row="2" Margin="0,14,0,0">
      <TabControl
                  Grid.RowSpan="2"
                  BorderThickness="0"
                  Background="Transparent">
        <TabControl.Resources>
          <Style TargetType="TabPanel">
            <Setter Property="Margin" Value="0,0,0,-1" />
          </Style>
          <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="Foreground" Value="#FF52627F" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                  <Border x:Name="Chrome"
                          Background="Transparent"
                          BorderBrush="Transparent"
                          BorderThickness="0,0,0,2"
                          Padding="{TemplateBinding Padding}">
                    <ContentPresenter ContentSource="Header" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Chrome" Property="BorderBrush" Value="#FF2967EF" />
                      <Setter Property="Foreground" Value="#FF174FCB" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </TabControl.Resources>

        <TabItem Header="Structure">
          <Grid x:Name="StructureGrid" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition x:Name="LeftPanelColumn" Width="1.08*" />
              <ColumnDefinition x:Name="LeftSpacer1Column" Width="14" />
              <ColumnDefinition x:Name="MiddlePanelColumn" Width="1.02*" />
              <ColumnDefinition x:Name="LeftSpacer2Column" Width="14" />
              <ColumnDefinition Width="1.08*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{DynamicResource AppCardStyle}" Padding="0">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button x:Name="PdmStructureToggleBtn"
                        Grid.Row="0"
                        Style="{StaticResource CardHeaderButtonStyle}"
                        IsTabStop="False"
                        Margin="18,14,18,10"
                        Click="OnPdmStructureToggleClick">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PdmStructureTitle"
                               Style="{DynamicResource SectionTitleStyle}"
                               Text="PDM Structure" />
                    <TextBlock x:Name="PdmStructureIcon"
                               Grid.Column="1"
                               FontSize="14"
                               Foreground="#FF60708E"
                               Text="&#x25C0;" />
                  </Grid>
                </Button>

                <Grid x:Name="PdmStructureSlideContent" Grid.Row="1">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>

                  <DockPanel Grid.Row="0" Margin="18,0,18,12">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                      <Button Margin="0,0,10,0"
                              Padding="10,6"
                              Background="Transparent"
                              BorderBrush="Transparent"
                              Foreground="#FF405173"
                              FontSize="12"
                              FontWeight="SemiBold"
                              Click="OnExpandAllClick"
                              Content="Expand All" />
                      <Button Margin="0,0,10,0"
                              Padding="10,6"
                              Background="Transparent"
                              BorderBrush="Transparent"
                              Foreground="#FF405173"
                              FontSize="12"
                              FontWeight="SemiBold"
                              Click="OnCollapseAllClick"
                              Content="Collapse All" />
                    </StackPanel>
                    <DockPanel DockPanel.Dock="Right">
                      <TextBlock FontFamily="Segoe MDL2 Assets"
                                 Margin="0,0,6,0"
                                 VerticalAlignment="Center"
                                 Foreground="#FF52627F"
                                 Text="&#xE721;" />
                      <TextBlock VerticalAlignment="Center"
                                 FontSize="12"
                                 Foreground="#FF52627F"
                                 Text="Search" />
                    </DockPanel>
                  </DockPanel>

                  <Grid x:Name="PdmStructureContent" Grid.Row="1">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                  <Border Margin="0,0,0,8"
                          Padding="18,10"
                          BorderBrush="#FFE6ECF5"
                          BorderThickness="0,1,0,1">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="42" />
                      </Grid.ColumnDefinitions>
                      <TextBlock FontSize="12" Foreground="#FF60708E" Text="Part / Description" />
                      <TextBlock Grid.Column="1" HorizontalAlignment="Center" FontSize="12" Foreground="#FF60708E" Text="Type" />
                      <TextBlock Grid.Column="2" HorizontalAlignment="Center" FontSize="12" Foreground="#FF60708E" Text="Quantity" />
                      <TextBlock Grid.Column="3" HorizontalAlignment="Center" FontSize="12" Foreground="#FF60708E" Text="Status" />
                    </Grid>
                  </Border>

                  <TreeView x:Name="StructureTree"
                            Grid.Row="1"
                            BorderThickness="0"
                            Background="White"
                            Padding="10,0,10,10"
                            ItemsSource="{Binding PdmStructure}"
                            SelectedItemChanged="OnStructureSelectionChanged">
                    <TreeView.Resources>
                      <Style x:Key="TreeExpandCollapseToggleStyle" TargetType="ToggleButton">
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Width" Value="22" />
                        <Setter Property="Height" Value="22" />
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="ToggleButton">
                              <Border Background="Transparent" CornerRadius="4">
                                <TextBlock x:Name="Arrow"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="10"
                                           Foreground="#FF7A879F"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Text="&#xE76B;" />
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                  <Setter TargetName="Arrow" Property="Text" Value="&#xE76C;" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style>

                      <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="True" />
                        <Setter Property="Padding" Value="10,6" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="TreeViewItem">
                              <Grid>
                                <Grid.RowDefinitions>
                                  <RowDefinition Height="Auto" />
                                  <RowDefinition />
                                </Grid.RowDefinitions>
                                <Border x:Name="NodeBorder"
                                        Margin="0,3"
                                        Padding="{TemplateBinding Padding}"
                                        Background="Transparent"
                                        CornerRadius="10">
                                  <Grid>
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="Auto" />
                                      <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Expander"
                                                  Style="{StaticResource TreeExpandCollapseToggleStyle}"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ClickMode="Press" />
                                    <Grid Grid.Column="1">
                                      <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                      </Grid.ColumnDefinitions>
                                      <Border x:Name="HeaderConnector"
                                              Grid.Column="0"
                                              Height="1"
                                              Width="10"
                                              Margin="0,0,4,0"
                                              Background="#FFDDE6F3"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                                      <ContentPresenter Grid.Column="1"
                                                        ContentSource="Header"
                                                        HorizontalAlignment="Stretch" />
                                    </Grid>
                                  </Grid>
                                </Border>
                                <Grid x:Name="ChildrenHost" Grid.Row="1" Margin="34,0,0,0">
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                  </Grid.ColumnDefinitions>
                                  <Border Grid.Column="0"
                                          x:Name="VerticalConnector"
                                          Width="1"
                                          Margin="8,0,0,8"
                                          Background="#FFE1E8F4"
                                          HorizontalAlignment="Center" />
                                  <ItemsPresenter x:Name="ItemsHost" Grid.Column="1" Margin="10,0,0,0" />
                                </Grid>
                              </Grid>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                  <Setter TargetName="NodeBorder" Property="Background" Value="#FFF2F7FF" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                  <Setter TargetName="NodeBorder" Property="Background" Value="#FFF8FBFF" />
                                </Trigger>
                                <Trigger Property="IsExpanded" Value="False">
                                  <Setter TargetName="ChildrenHost" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="IsExpanded" Value="True">
                                  <Setter TargetName="ChildrenHost" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="HasItems" Value="False">
                                  <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                                  <Setter TargetName="HeaderConnector" Property="Width" Value="18" />
                                  <Setter TargetName="ChildrenHost" Property="Visibility" Value="Collapsed" />
                                  <Setter TargetName="VerticalConnector" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style>
                    </TreeView.Resources>
                  </TreeView>

                  <StackPanel HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Visibility="Collapsed">
                    <StackPanel.Style>
                      <Style TargetType="StackPanel">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasPdmStructure}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </StackPanel.Style>
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="36"
                               Foreground="#FFC5CDDB"
                               HorizontalAlignment="Center"
                               Text="&#xE8FD;" />
                    <TextBlock Margin="0,10,0,4"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#FF60708E"
                               HorizontalAlignment="Center"
                               Text="No structure yet" />
                  </StackPanel>
                </Grid>
              </Grid>
              </Grid>
            </Border>

            <Border Grid.Column="2" Style="{DynamicResource AppCardStyle}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button x:Name="CadStructureToggleBtn"
                        Grid.Row="0"
                        Style="{StaticResource CardHeaderButtonStyle}"
                        IsTabStop="False"
                        Margin="18,14,18,10"
                        Click="OnCadStructureToggleClick">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CadStructureTitle"
                               Style="{DynamicResource SectionTitleStyle}"
                               Text="CAD Structure" />
                    <TextBlock x:Name="CadStructureIcon"
                               Grid.Column="1"
                               FontSize="14"
                               Foreground="#FF60708E"
                               Text="&#x25C0;" />
                  </Grid>
                </Button>

                <Grid x:Name="CadStructureBody" Grid.Row="1">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>

                  <Grid x:Name="CadStructureContent" Grid.Row="0">
                    <Border Margin="18,0,18,14"
                            BorderBrush="#FFE7EDF6"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="8">
                      <TreeView x:Name="CadStructureTree"
                                BorderThickness="0"
                                Background="Transparent"
                                ItemsSource="{Binding CadStructure}"
                                SelectedItemChanged="OnStructureSelectionChanged" />
                    </Border>
                  </Grid>

                  <TextBlock Grid.Row="1"
                             Margin="18,0,18,8"
                             Style="{DynamicResource SectionTitleStyle}"
                             Text="Mapping" />

                  <Border Grid.Row="2"
                          Margin="18,0,18,18"
                          BorderBrush="#FFE7EDF6"
                          BorderThickness="1"
                          CornerRadius="12"
                          Padding="0">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                      </Grid.RowDefinitions>

                      <Border Padding="14,10"
                              BorderBrush="#FFE6ECF5"
                              BorderThickness="0,0,0,1">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="120" />
                          </Grid.ColumnDefinitions>
                          <TextBlock FontSize="12" Foreground="#FF60708E" Text="PDM Node" />
                          <TextBlock Grid.Column="1" HorizontalAlignment="Center" FontSize="12" Foreground="#FF60708E" Text="Type" />
                          <TextBlock Grid.Column="2" FontSize="12" Foreground="#FF60708E" Text="Mapped CAD" />
                          <TextBlock Grid.Column="3" HorizontalAlignment="Right" FontSize="12" Foreground="#FF60708E" Text="Status" />
                        </Grid>
                      </Border>

                      <ListBox Grid.Row="1"
                               ItemsSource="{Binding StructureMappings}"
                               BorderThickness="0"
                               Background="Transparent"
                               ScrollViewer.VerticalScrollBarVisibility="Auto"
                               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                          <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                              <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                  <Border Background="{TemplateBinding Background}">
                                    <ContentPresenter />
                                  </Border>
                                </ControlTemplate>
                              </Setter.Value>
                            </Setter>
                          </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                          <DataTemplate>
                            <Border Padding="14,12"
                                    BorderBrush="#FFF0F3F8"
                                    BorderThickness="0,0,0,1">
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="1.3*" />
                                  <ColumnDefinition Width="84" />
                                  <ColumnDefinition Width="1.5*" />
                                  <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                  <TextBlock FontSize="12"
                                             FontWeight="SemiBold"
                                             Foreground="#FF1B2B55"
                                             Text="{Binding PdmName}" />
                                  <TextBlock Margin="0,2,0,0"
                                             FontSize="10"
                                             Foreground="#FF7A879F"
                                             Text="{Binding PdmCode}" />
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Width="72"
                                        HorizontalAlignment="Center"
                                        Padding="8,4"
                                        CornerRadius="8"
                                        Background="#FFF4F7FC">
                                  <TextBlock HorizontalAlignment="Center"
                                             FontSize="11"
                                             FontWeight="SemiBold"
                                             Foreground="#FF52627F"
                                             Text="{Binding NodeType}" />
                                </Border>

                                <TextBlock Grid.Column="2"
                                           Margin="12,0,12,0"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Foreground="#FF405173"
                                           Text="{Binding MappedCad}"
                                           TextTrimming="CharacterEllipsis" />

                                <TextBlock Grid.Column="3"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#FF174FCB"
                                           Text="{Binding Status}" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </Grid>
                  </Border>
                </Grid>
              </Grid>
            </Border>

            <Grid Grid.Column="4">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <Border Grid.Row="0" Style="{DynamicResource AppCardStyle}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <Border Width="64" Height="64" CornerRadius="16" Background="#FF8A3FFC">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="28"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Text="&#xE8FD;" />
                  </Border>

                  <Button Grid.Column="2"
                          x:Name="LeftPanelToggleButton"
                          Width="24"
                          Height="24"
                          Margin="0,2,0,0"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="#FF60708E"
                          FontSize="14"
                          VerticalAlignment="Top"
                          HorizontalAlignment="Right"
                          ToolTip="Toggle structure panels"
                          Click="OnLeftPanelToggleClick"
                          Content="&#x25C0;" />

                  <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <TextBlock Style="{DynamicResource SectionTitleStyle}" Text="Selected Node" />
                    <TextBlock Margin="0,12,0,0"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#FF172B57"
                               Text="{Binding SelectedNode.Name, TargetNullValue=-}" />
                    <TextBlock Margin="0,6,0,0"
                               FontSize="12"
                               Foreground="#FF60708E"
                               TextWrapping="Wrap"
                               Text="{Binding SelectedNode.PartCode, TargetNullValue=-}" />

                    <Grid Margin="0,14,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                     <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <TextBlock Style="{StaticResource MetricLabelStyle}" Text="Type" />
                      <TextBlock Grid.Column="1" FontSize="13" Foreground="#FF7045D7" Text="{Binding SelectedNode.NodeType, TargetNullValue=-}" />
                      <TextBlock Grid.Row="1" Style="{StaticResource MetricLabelStyle}" Text="Quantity" />
                      <TextBlock Grid.Row="1" Grid.Column="1" FontSize="13" Foreground="#FF172B57" Text="{Binding SelectedNode.Quantity, TargetNullValue=-}" />
                      <TextBlock Grid.Row="2" Style="{StaticResource MetricLabelStyle}" Text="Revision" />
                      <TextBlock Grid.Row="2" Grid.Column="1" FontSize="13" Foreground="#FF172B57" Text="{Binding SelectedNode.Revision, TargetNullValue=-}" />
                      <TextBlock Grid.Row="3" Style="{StaticResource MetricLabelStyle}" Text="Perspective" />
                      <TextBlock Grid.Row="3" Grid.Column="1" FontSize="13" Foreground="#FF172B57" Text="{Binding SelectedNode.Perspective, TargetNullValue=-}" />
                      <TextBlock Grid.Row="4" Style="{StaticResource MetricLabelStyle}" Text="Branch" />
                      <TextBlock Grid.Row="4" Grid.Column="1" FontSize="13" Foreground="#FF172B57" Text="{Binding SelectedBranch, TargetNullValue=-}" />
                    </Grid>
                  </StackPanel>
                </Grid>
              </Border>

              <Border Grid.Row="2" Style="{DynamicResource AppCardStyle}">
                <StackPanel>
                  <Button Style="{StaticResource CardHeaderButtonStyle}"
                          Command="{Binding ToggleCadSectionCommand}"
                          IsTabStop="False">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Style="{DynamicResource SectionTitleStyle}" Text="Primary CAD" />
                      <TextBlock Grid.Column="1" FontSize="14" Foreground="#FF60708E" Text="{Binding CadSectionIcon}" />
                    </Grid>
                  </Button>
                  <StackPanel Visibility="{Binding IsCadSectionExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DockPanel Margin="0,14,0,0">
                    <Border Width="40" Height="40" CornerRadius="10" Background="#FF13A8A1" DockPanel.Dock="Left">
                      <TextBlock FontFamily="Segoe MDL2 Assets"
                                 FontSize="18"
                                 Foreground="White"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Text="&#xE8B7;" />
                    </Border>
                    <TextBlock Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="#FF1B2B55"
                               TextWrapping="Wrap"
                               Text="{Binding SelectedNode.PrimaryCad, TargetNullValue=-}" />
                  </DockPanel>

                  <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="110" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource MetricLabelStyle}" Text="State" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                      <Ellipse Width="9" Height="9" Fill="#FF13A444" Margin="0,0,8,0" VerticalAlignment="Center" />
                      <TextBlock FontSize="13" Foreground="#FF172B57" Text="Checked out" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Style="{StaticResource MetricLabelStyle}" Text="Source doc" />
                    <TextBlock Grid.Row="1" Grid.Column="1" FontSize="13" Foreground="#FF172B57" Text="{Binding SelectedNode.SourceDocument, TargetNullValue=-}" />
                    <TextBlock Grid.Row="2" Style="{StaticResource MetricLabelStyle}" Text="Locked By" />
                    <TextBlock Grid.Row="2" Grid.Column="1" FontSize="13" Foreground="#FF172B57" Text="{Binding SelectedNode.LockedBy, TargetNullValue=admin}" />
                  </Grid>

                  <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="12" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Height="40"
                            Background="White"
                            BorderBrush="#FF18B7AE"
                            BorderThickness="1.5"
                            Foreground="#FF109A93"
                            FontWeight="SemiBold"
                            Command="{Binding OpenInIronCadCommand}"
                            Content="Open in IronCAD" />
                    <Button Grid.Column="2"
                            Height="40"
                            Background="#FF14B1A7"
                            BorderBrush="#FF14B1A7"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Content="Check-in" />
                  </Grid>

                  <Button Margin="0,10,0,0"
                          Height="40"
                          Background="White"
                          BorderBrush="#FFFF7A7A"
                          BorderThickness="1.5"
                          Foreground="#FFF14E4E"
                          FontWeight="SemiBold"
                          Content="Cancel Checkout" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Grid.Row="4" Style="{DynamicResource AppCardStyle}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <Button Style="{StaticResource CardHeaderButtonStyle}"
                          Command="{Binding ToggleDocumentsSectionCommand}"
                          IsTabStop="False">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Style="{DynamicResource SectionTitleStyle}" Text="Documents" />
                      <TextBlock Grid.Column="1" FontSize="14" Foreground="#FF60708E" Text="{Binding DocumentsSectionIcon}" />
                    </Grid>
                  </Button>
                  <ListBox Grid.Row="1"
                           Visibility="{Binding IsDocumentsSectionExpanded, Converter={StaticResource BoolToVisibilityConverter}}"
                           Margin="0,14,0,0"
                           BorderThickness="0"
                           Background="Transparent"
                           ItemsSource="{Binding Documents}"
                           MouseDoubleClick="DocumentListBox_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Border Margin="0,0,0,8"
                                Padding="12"
                                BorderBrush="#FFE8EEF6"
                                BorderThickness="1"
                                CornerRadius="10">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="12"
                                       Foreground="#FF1B2B55"
                                       Text="{Binding Name}" />
                            <TextBlock Grid.Column="1"
                                       HorizontalAlignment="Right"
                                       FontSize="12"
                                       Foreground="#FF60708E"
                                       Text="{Binding Kind}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Border>
            </Grid>
          </Grid>
        </TabItem>

        <TabItem Header="Push Preview">
          <Border Margin="0,14,0,0" Style="{DynamicResource AppCardStyle}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <DockPanel Margin="18,14,18,8">
                <TextBlock DockPanel.Dock="Left"
                           Style="{DynamicResource SectionTitleStyle}"
                           Text="Push Preview" />
                <Border DockPanel.Dock="Right"
                        Margin="8,0,0,0"
                        Padding="12,4"
                        CornerRadius="10"
                        Background="#FFF0F5FF">
                  <TextBlock Style="{StaticResource BadgeTextStyle}"
                             Text="{Binding PushPreviewReadiness.Summary, TargetNullValue=Analyze folder to generate preview}" />
                </Border>
              </DockPanel>

              <Border Grid.Row="1"
                      Margin="18,0,18,0"
                      Padding="16"
                      BorderBrush="#FFE7EDF6"
                      BorderThickness="1"
                      CornerRadius="12">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Style="{StaticResource MetricLabelStyle}" Text="Parts" />
                  <TextBlock Grid.Column="1" Style="{StaticResource MetricValueStyle}" Text="{Binding PreviewParts.Count}" />
                  <TextBlock Grid.Column="2" Style="{StaticResource MetricLabelStyle}" Text="CADs" />
                  <TextBlock Grid.Column="3" Style="{StaticResource MetricValueStyle}" Text="{Binding PreviewCads.Count}" />
                  <TextBlock Grid.Row="1" Style="{StaticResource MetricLabelStyle}" Text="Documents" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource MetricValueStyle}" Text="{Binding PreviewDocuments.Count}" />
                  <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource MetricLabelStyle}" Text="Ignored" />
                  <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource MetricValueStyle}" Text="{Binding PreviewIgnoredFiles.Count}" />
                </Grid>
              </Border>

              <TabControl Grid.Row="2"
                          Margin="14,14,14,14"
                          BorderThickness="0"
                          Background="Transparent">
                <TabControl.Resources>
                  <Style TargetType="TabPanel">
                    <Setter Property="Margin" Value="0" />
                  </Style>
                  <Style TargetType="TabItem">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="#FFE3EAF5" />
                    <Setter Property="Foreground" Value="#FF52627F" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Padding" Value="14,6" />
                  </Style>
                </TabControl.Resources>

                <TabItem Header="Parts">
                  <Border BorderThickness="1"
                          BorderBrush="#FFE3EAF5"
                          CornerRadius="12"
                          Background="White">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto"
                                  Padding="12">
                    <ItemsControl ItemsSource="{Binding PreviewParts}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Margin="0,0,0,8"
                                  Padding="16,12"
                                  BorderBrush="#FFE3EAF5"
                                  BorderThickness="1"
                                  CornerRadius="10"
                                  Background="#FFFAFBFD">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="100" />
                              </Grid.ColumnDefinitions>
                              <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#FF1B2B55"
                                         VerticalAlignment="Center" Text="{Binding PartNumber}" />
                              <TextBlock Grid.Column="1" FontSize="13" Foreground="#FF52627F"
                                         VerticalAlignment="Center" Text="{Binding Name}" />
                              <TextBlock Grid.Column="2" FontSize="13" Foreground="#FF60708E"
                                         VerticalAlignment="Center" Text="{Binding Classification}" />
                              <TextBlock Grid.Column="3" FontSize="13" Foreground="#FF1B2B55"
                                         VerticalAlignment="Center" Text="{Binding Quantity}" />
                              <Border Grid.Column="4" Padding="10,5" CornerRadius="8"
                                      Background="#FFF0F5FF" VerticalAlignment="Center">
                                <TextBlock FontSize="12" FontWeight="SemiBold"
                                           Foreground="#FF174FCB" Text="{Binding Action}" />
                              </Border>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Border>
                </TabItem>

                <TabItem Header="CADs">
                  <Border BorderThickness="1"
                          BorderBrush="#FFE3EAF5"
                          CornerRadius="12"
                          Background="White">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto"
                                  Padding="12">
                    <ItemsControl ItemsSource="{Binding PreviewCads}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Margin="0,0,0,8"
                                  Padding="16,12"
                                  BorderBrush="#FFE3EAF5"
                                  BorderThickness="1"
                                  CornerRadius="10"
                                  Background="#FFFAFBFD">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="100" />
                              </Grid.ColumnDefinitions>
                              <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#FF1B2B55"
                                         VerticalAlignment="Center" Text="{Binding SourceFileName}" />
                              <TextBlock Grid.Column="1" FontSize="13" Foreground="#FF52627F"
                                         VerticalAlignment="Center" Text="{Binding LogicalCode}" />
                              <TextBlock Grid.Column="2" FontSize="13" Foreground="#FF60708E"
                                         VerticalAlignment="Center" Text="{Binding CadNumber}" />
                              <TextBlock Grid.Column="3" FontSize="13" Foreground="#FF60708E"
                                         VerticalAlignment="Center" Text="{Binding Classification}" />
                              <Border Grid.Column="4" Padding="10,5" CornerRadius="8"
                                      Background="#FFF0F5FF" VerticalAlignment="Center">
                                <TextBlock FontSize="12" FontWeight="SemiBold"
                                           Foreground="#FF174FCB" Text="{Binding Action}" />
                              </Border>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Border>
                </TabItem>

                <TabItem Header="Documents">
                  <Border BorderThickness="1"
                          BorderBrush="#FFE3EAF5"
                          CornerRadius="12"
                          Background="White">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto"
                                  Padding="12">
                    <ItemsControl ItemsSource="{Binding PreviewDocuments}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Margin="0,0,0,8"
                                  Padding="16,12"
                                  BorderBrush="#FFE3EAF5"
                                  BorderThickness="1"
                                  CornerRadius="10"
                                  Background="#FFFAFBFD">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="100" />
                              </Grid.ColumnDefinitions>
                              <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#FF1B2B55"
                                         VerticalAlignment="Center" Text="{Binding SourceFileName}" />
                              <TextBlock Grid.Column="1" FontSize="13" Foreground="#FF52627F"
                                         VerticalAlignment="Center" Text="{Binding DocumentNumber}" />
                              <TextBlock Grid.Column="2" FontSize="13" Foreground="#FF60708E"
                                         VerticalAlignment="Center" Text="{Binding Classification}" />
                              <TextBlock Grid.Column="3" FontSize="13" Foreground="#FF60708E"
                                         VerticalAlignment="Center" Text="{Binding LinkTargetType}" />
                              <Border Grid.Column="4" Padding="10,5" CornerRadius="8"
                                      Background="#FFF0F5FF" VerticalAlignment="Center">
                                <TextBlock FontSize="12" FontWeight="SemiBold"
                                           Foreground="#FF174FCB" Text="{Binding Action}" />
                              </Border>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Border>
                </TabItem>

                <TabItem Header="Ignored">
                  <Border BorderThickness="1"
                          BorderBrush="#FFE3EAF5"
                          CornerRadius="12"
                          Background="White">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto"
                                  Padding="12">
                    <ItemsControl ItemsSource="{Binding PreviewIgnoredFiles}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Margin="0,0,0,8"
                                  Padding="16,12"
                                  BorderBrush="#FFE3EAF5"
                                  BorderThickness="1"
                                  CornerRadius="10"
                                  Background="#FFFAFBFD">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#FF1B2B55"
                                         VerticalAlignment="Center" Text="{Binding SourceFileName}" />
                              <TextBlock Grid.Column="1" FontSize="13" Foreground="#FF60708E"
                                         VerticalAlignment="Center" Text="{Binding Reason}" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Border>
                </TabItem>
              </TabControl>
            </Grid>
          </Border>
        </TabItem>
      </TabControl>
    </Grid>

    <Grid Grid.Row="3" Margin="4,14,4,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock FontSize="12"
                 Foreground="#FF60708E"
                 Text="{Binding FolderPath, StringFormat=Workspace: {0}}" />
      <TextBox Grid.Column="1"
               Margin="18,0,0,0"
               FontSize="12"
               Foreground="#FF60708E"
               Text="{Binding StatusMessage}"
               IsReadOnly="True"
               BorderThickness="0"
               Background="Transparent"
               TextWrapping="Wrap"
               IsTabStop="False" />
      <TextBlock Grid.Column="2"
                 Margin="18,0,0,0"
                 FontSize="12"
                 Foreground="#FF60708E"
                 Text="{Binding NamingPolicyVersion, StringFormat=Naming policy {0}}" />
    </Grid>
  </Grid>
</UserControl>
