<Window x:Class="IdeaCadConnector.Desktop.AddLibraryPartToProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Reusable Part to Current PDM Project" Width="980" Height="760"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F8FAFD">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="#E4EAF3" BorderThickness="0,0,0,1" Padding="24,20">
            <StackPanel><TextBlock Text="Add Reusable Part to Current PDM Project" FontSize="24" FontWeight="Bold" Foreground="#17305F"/><TextBlock Text="Reference an existing Aras Part in the local working tree, then commit and push to update Part BOM." Margin="0,5,0,0" Foreground="#687995"/></StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24">
                <Border Background="#F9FBFF" BorderBrush="#DDE5F1" BorderThickness="1" CornerRadius="12" Padding="14">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="46" Height="46" CornerRadius="12" Background="#7C3AED"><TextBlock Text="&#xE7B8;" FontFamily="Segoe Fluent Icons" FontSize="23" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding PartNumber}" FontSize="17" FontWeight="Bold" Foreground="#17305F"/><TextBlock Text="{Binding ResolvedPartSummary}" FontSize="12" Foreground="#687995"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding ReuseBadge}" VerticalAlignment="Center" Foreground="#0F8F86"/></Grid>
                </Border>
                <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Current Repository" FontWeight="SemiBold" Foreground="#334B76"/><TextBox Height="42" Margin="0,7,0,0" Text="{Binding RepositoryCode, Mode=OneWay}" IsReadOnly="True"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Branch" FontWeight="SemiBold" Foreground="#334B76"/><TextBox Height="42" Margin="0,7,0,0" Text="{Binding BranchName, Mode=OneWay}" IsReadOnly="True"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="Base Commit" FontWeight="SemiBold" Foreground="#334B76"/><TextBox Height="42" Margin="0,7,0,0" Text="{Binding BaseCommitSummary, Mode=OneWay}" IsReadOnly="True"/></StackPanel></Grid>
                <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Target Parent in Product Structure" FontWeight="SemiBold" Foreground="#334B76"/><ComboBox Height="42" Margin="0,7,0,0" ItemsSource="{Binding ParentCandidates}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedParent}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Quantity" FontWeight="SemiBold" Foreground="#334B76"/><TextBox Height="42" Margin="0,7,0,0" Text="{Binding Quantity}" VerticalContentAlignment="Center"/></StackPanel></Grid>
                <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border BorderBrush="#DDE5F1" BorderThickness="1" CornerRadius="12" Padding="16"><StackPanel><TextBlock Text="Reuse Mode" FontSize="16" FontWeight="Bold" Foreground="#17305F"/><RadioButton Content="Reference existing Part" Margin="0,14,0,0" IsChecked="{Binding UseExistingPart}"/><TextBlock Text="Uses the resolved Aras Part ID. No duplicate Part or CAD is created." FontSize="11" Foreground="#687995" Margin="24,4,0,0"/><RadioButton Content="Clone as a new Part" Margin="0,14,0,0" IsEnabled="False"/><TextBlock Text="Not included in the first MVP." FontSize="11" Foreground="#687995" Margin="24,4,0,0"/></StackPanel></Border><Border Grid.Column="2" BorderBrush="#DDE5F1" BorderThickness="1" CornerRadius="12" Padding="16"><StackPanel><TextBlock Text="Workspace Actions" FontSize="16" FontWeight="Bold" Foreground="#17305F"/><CheckBox Content="Add to working tree" Margin="0,14,0,0" IsChecked="{Binding AddToWorkingTree}"/><CheckBox Content="Keep linked CAD reference" Margin="0,10,0,0" IsChecked="{Binding KeepCadReference}"/><CheckBox Content="Download native CAD file now" Margin="0,10,0,0" IsChecked="{Binding DownloadCadNow}"/><CheckBox Content="Record Library usage after successful Push" Margin="0,10,0,0" IsChecked="{Binding RecordUsage}"/></StackPanel></Border></Grid>
                <Border Margin="0,16,0,0" Padding="12" CornerRadius="10" Background="#FFF8E9" BorderBrush="#FFD59D" BorderThickness="1"><TextBlock Text="{Binding WorkspaceWarning}" Foreground="#8B5800" TextWrapping="Wrap"/></Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="White" BorderBrush="#E4EAF3" BorderThickness="0,1,0,0" Padding="24,16"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Width="96" Height="40" Content="Cancel" IsCancel="True"/><Button Width="170" Height="40" Margin="10,0,0,0" Content="Preview Working Tree" Command="{Binding PreviewCommand}"/><Button Width="130" Height="40" Margin="10,0,0,0" Content="Add to Project" Command="{Binding AddCommand}" IsDefault="True" Background="#0B57F0" Foreground="White"/></StackPanel></Border>
    </Grid>
</Window>
