<Window x:Class="IdeaCadConnector.Desktop.MoveLibraryEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:IdeaCadConnector.Core.Localization;assembly=IdeaCadConnector.Core"
        Title="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[MoveEntryTitle]}" Width="520" Height="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None"
        Background="#F8FAFD"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="White" BorderBrush="#E4EAF3" BorderThickness="0,0,0,1" Padding="24,20">
            <StackPanel>
                <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[MoveEntryTitle]}" FontSize="22" FontWeight="Bold" Foreground="#17305F"/>
                <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[MoveEntrySubtitle]}"
                           Margin="0,5,0,0" TextWrapping="Wrap" Foreground="#687995"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24">
                <Border Background="#F0F5FF" Padding="16" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[MoveEntryPartNumberLabel]}" FontWeight="SemiBold" Foreground="#334B76" FontSize="11"/>
                        <TextBlock Text="{Binding PartNumber}" FontWeight="Bold" Foreground="#17305F" Margin="0,2,0,8"/>

                        <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[MoveEntryPartNameLabel]}" FontWeight="SemiBold" Foreground="#334B76" FontSize="11"/>
                        <TextBlock Text="{Binding PartName}" Foreground="#17305F" Margin="0,2,0,8"/>

                        <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[MoveEntryCurrentLibraryLabel]}" FontWeight="SemiBold" Foreground="#334B76" FontSize="11"/>
                        <TextBlock Text="{Binding CurrentLibraryName}" Foreground="#17305F" Margin="0,2,0,8"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[MoveEntryEntryStatusLabel]}" FontWeight="SemiBold" Foreground="#334B76" FontSize="11"/>
                                <TextBlock Text="{Binding EntryStatus}" Foreground="#17305F" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[MoveEntryRevisionPolicyLabel]}" FontWeight="SemiBold" Foreground="#334B76" FontSize="11"/>
                                <TextBlock Text="{Binding RevisionPolicy}" Foreground="#17305F" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,20,0,0">
                    <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[MoveEntryTargetLibraryLabel]}" FontWeight="SemiBold" Foreground="#334B76"/>
                    <ComboBox Height="42" Margin="0,7,0,0"
                              ItemsSource="{Binding TargetLibraries}"
                              SelectedItem="{Binding SelectedTargetLibrary}"
                              DisplayMemberPath="Name"
                              Visibility="{Binding HasLoadedTargets, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBlock Margin="0,7,0,0"
                               Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[MoveEntryLoadingTargets]}"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                               Foreground="#2E7D32"/>
                </StackPanel>

                <Border Background="#FFF7ED" Padding="12" CornerRadius="8" Margin="0,16,0,0"
                        BorderBrush="#FDBA74" BorderThickness="1">
                    <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[MoveEntryPreservationWarning]}"
                               TextWrapping="Wrap" Foreground="#9A3412" FontSize="12"/>
                </Border>

                <TextBlock Margin="0,12,0,0" Text="{Binding ErrorMessage}"
                           Foreground="#B91C1C" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="#E4EAF3" BorderThickness="0,1,0,0" Padding="24,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="110" Height="40"
                        Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[MoveEntryCancelButton]}"
                        IsCancel="True" Command="{Binding CancelCommand}"/>
                <Button Width="140" Height="40" Margin="10,0,0,0"
                        Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[MoveEntryMoveButton]}"
                        Command="{Binding MoveCommand}"
                        IsDefault="True"
                        Background="#0B57F0" Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
