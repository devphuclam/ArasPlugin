<Window x:Class="IdeaCadConnector.Desktop.SaveToLibraryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:IdeaCadConnector.Core.Localization;assembly=IdeaCadConnector.Core"
        Title="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[SaveToLibraryTitle]}"
        Width="900"
        Height="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#EEF3FA"
        FontFamily="Segoe UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <SolidColorBrush x:Key="DialogTextBrush" Color="#172B55"/>
        <SolidColorBrush x:Key="DialogMutedBrush" Color="#61708E"/>
        <SolidColorBrush x:Key="DialogLineBrush" Color="#D9E3F0"/>
        <SolidColorBrush x:Key="DialogPrimaryBrush" Color="#1E5AF7"/>

        <Style x:Key="DialogLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#28416C"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="DialogTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource DialogTextBrush}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C9D6EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="DialogComboBoxStyle"
               TargetType="{x:Type ComboBox}"
               BasedOn="{StaticResource SharedComboBoxStyle}"/>

        <Style x:Key="DialogButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Foreground" Value="{StaticResource DialogTextBrush}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C9D6EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F4F7FC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogPrimaryButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource DialogPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DialogPrimaryBrush}"/>
        </Style>
    </Window.Resources>

    <Border Margin="18"
            Background="White"
            BorderBrush="#DDE6F2"
            BorderThickness="1"
            CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border BorderBrush="{StaticResource DialogLineBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="26,22,26,18">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[SaveToLibraryTitle]}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource DialogTextBrush}"/>
                        <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[SaveToLibrarySubtitle]}"
                                   Margin="0,6,0,0"
                                   Foreground="{StaticResource DialogMutedBrush}"
                                   FontSize="13"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Width="32"
                            Height="32"
                            Content="x"
                            FontSize="16"
                            IsCancel="True"
                            Style="{StaticResource DialogButtonStyle}"
                            BorderThickness="0"
                            Background="Transparent"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="26,22">
                    <Border BorderBrush="{StaticResource DialogLineBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14"
                            Background="#F8FBFF">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="48"
                                    Height="48"
                                    CornerRadius="10"
                                    Background="#7C3AED">
                                <TextBlock Text="&#xE8A5;"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="22"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedPartSummary}"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource DialogTextBrush}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedPartId}"
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource DialogMutedBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[SaveToLibraryPartIdRequirementHint]}"
                                           Margin="0,7,0,0"
                                           Foreground="{StaticResource DialogMutedBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[SaveToLibraryTargetLibrary]}"
                                       Style="{StaticResource DialogLabelStyle}"/>
                            <ComboBox Margin="0,8,0,0"
                                      Style="{StaticResource DialogComboBoxStyle}"
                                      ItemsSource="{Binding WritableLibraries}"
                                      DisplayMemberPath="Name"
                                      SelectedItem="{Binding SelectedLibrary}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[SaveToLibraryRevisionPolicyLabel]}"
                                       Style="{StaticResource DialogLabelStyle}"/>
                            <ComboBox Margin="0,8,0,0"
                                      Style="{StaticResource DialogComboBoxStyle}"
                                      ItemsSource="{Binding RevisionPolicies}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedItem="{Binding SelectedRevisionPolicy}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[SaveToLibraryCategory]}"
                                       Style="{StaticResource DialogLabelStyle}"/>
                            <TextBox Margin="0,8,0,0"
                                     Style="{StaticResource DialogTextBoxStyle}"
                                     Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[SaveToLibraryTags]}"
                                       Style="{StaticResource DialogLabelStyle}"/>
                            <TextBox Margin="0,8,0,0"
                                     Style="{StaticResource DialogTextBoxStyle}"
                                     Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,16,0,0">
                        <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[SaveToLibraryNote]}"
                                   Style="{StaticResource DialogLabelStyle}"/>
                        <TextBox Height="86"
                                 Margin="0,8,0,0"
                                 Padding="12,10"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 Style="{StaticResource DialogTextBoxStyle}"
                                 Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[SaveToLibrarySourceProject]}"
                                       Style="{StaticResource DialogLabelStyle}"/>
                            <TextBox Margin="0,8,0,0"
                                     Style="{StaticResource DialogTextBoxStyle}"
                                     Text="{Binding SourceProject, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[SaveToLibrarySourceCommit]}"
                                       Style="{StaticResource DialogLabelStyle}"/>
                            <TextBox Margin="0,8,0,0"
                                     Style="{StaticResource DialogTextBoxStyle}"
                                     Text="{Binding SourceCommit, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <Border Margin="0,18,0,0"
                            Padding="14"
                            CornerRadius="10"
                            Background="#ECFDF3"
                            BorderBrush="#BDECCB"
                            BorderThickness="1">
                        <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[SaveToLibraryValidationReminders]}"
                                   Foreground="#087443"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Margin="0,10,0,0"
                               Foreground="#B42318"
                               TextWrapping="Wrap"
                               Text="{Binding ValidationMessage}"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="#FAFCFF"
                    BorderBrush="{StaticResource DialogLineBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="26,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Width="104"
                            Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[SaveToLibraryCancelButton]}"
                            IsCancel="True"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource DialogButtonStyle}"/>
                    <Button Width="168"
                            Margin="10,0,0,0"
                            Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[SaveToLibraryDisabledSubmit]}"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource DialogPrimaryButtonStyle}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
