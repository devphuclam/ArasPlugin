<Window x:Class="IdeaCadConnector.Desktop.SaveToLibraryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save Part to Library" Width="820" Height="720"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFD">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="White" BorderBrush="#E4EAF3" BorderThickness="0,0,0,1" Padding="24,20">
            <StackPanel>
                <TextBlock Text="Save Part to Library" FontSize="24" FontWeight="Bold" Foreground="#17305F"/>
                <TextBlock Text="Create a reusable reference to the existing Aras Part. No Part or CAD copy will be created."
                           Margin="0,5,0,0" Foreground="#687995"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1" Margin="24">
            <TextBlock Text="This MVP wires the Library workspace and reuse flow first. Save-to-Library server actions are scaffolded but not connected yet."
                       TextWrapping="Wrap" Foreground="#334B76"/>
        </Grid>
        <Border Grid.Row="2" Background="White" BorderBrush="#E4EAF3" BorderThickness="0,1,0,0" Padding="24,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="96" Height="40" Content="Close" IsCancel="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
