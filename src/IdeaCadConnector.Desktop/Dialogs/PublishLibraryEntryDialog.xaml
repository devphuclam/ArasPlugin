<Window x:Class="IdeaCadConnector.Desktop.PublishLibraryEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Publish to Standard Library"
        Width="980"
        Height="790"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#EEF3FA"
        FontFamily="Segoe UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <SolidColorBrush x:Key="DialogTextBrush" Color="#172B55"/>
        <SolidColorBrush x:Key="DialogMutedBrush" Color="#61708E"/>
        <SolidColorBrush x:Key="DialogLineBrush" Color="#D9E3F0"/>
        <SolidColorBrush x:Key="DialogPrimaryBrush" Color="#1E5AF7"/>

        <Style x:Key="DialogLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#28416C"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="DialogTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource DialogTextBrush}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C9D6EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="DialogComboBoxStyle"
               TargetType="{x:Type ComboBox}"
               BasedOn="{StaticResource SharedComboBoxStyle}"/>

        <Style x:Key="DialogButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Foreground" Value="{StaticResource DialogTextBrush}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C9D6EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F4F7FC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogPrimaryButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource DialogPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DialogPrimaryBrush}"/>
        </Style>
    </Window.Resources>

    <Border Margin="18"
            Background="White"
            BorderBrush="#DDE6F2"
            BorderThickness="1"
            CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border BorderBrush="{StaticResource DialogLineBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="26,22,26,18">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Publish to Standard Library"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource DialogTextBrush}"/>
                        <TextBlock Text="Submit a reusable Part for review before it becomes available to all engineers."
                                   Margin="0,6,0,0"
                                   Foreground="{StaticResource DialogMutedBrush}"
                                   FontSize="13"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Width="32"
                            Height="32"
                            Content="x"
                            FontSize="16"
                            IsCancel="True"
                            Style="{StaticResource DialogButtonStyle}"
                            BorderThickness="0"
                            Background="Transparent"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="26,22">
                    <Border BorderBrush="{StaticResource DialogLineBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14"
                            Background="#F8FBFF">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="48"
                                    Height="48"
                                    CornerRadius="10"
                                    Background="#7C3AED">
                                <TextBlock Text="&#xE8A5;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="22"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Selected reusable Part"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource DialogTextBrush}"/>
                                <TextBlock Text="Publish workflow is prepared visually, but the Aras workflow backend is not wired in this MVP slice."
                                           Margin="0,3,0,0"
                                           FontSize="12"
                                           Foreground="{StaticResource DialogMutedBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <Border Grid.Column="2"
                                    Background="#FFF7E8"
                                    CornerRadius="10"
                                    Padding="10,4"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Not wired"
                                           Foreground="#A15C00"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border BorderBrush="{StaticResource DialogLineBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16"
                                Background="#FBFDFF">
                            <StackPanel>
                                <TextBlock Text="Publish Checklist"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource DialogTextBrush}"/>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="22" Height="22" CornerRadius="11" Background="#DCFCE7">
                                        <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#087443" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Part lifecycle and CAD readiness validation"
                                               Foreground="{StaticResource DialogTextBrush}" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="22" Height="22" CornerRadius="11" Background="#DCFCE7">
                                        <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#087443" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Duplicate Library entry check"
                                               Foreground="{StaticResource DialogTextBrush}" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="22" Height="22" CornerRadius="11" Background="#FFF7E8">
                                        <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#A15C00" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Reviewer confirmation through live Aras workflow"
                                               Foreground="{StaticResource DialogTextBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                BorderBrush="{StaticResource DialogLineBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16"
                                Background="#FBFDFF">
                            <StackPanel>
                                <TextBlock Text="Revision Update"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource DialogTextBrush}"/>
                                <TextBlock Margin="0,12,0,0"
                                           Text="This placeholder keeps the Phase 2 UX honest: it shows the intended publish flow without creating unsupported server behavior."
                                           Foreground="{StaticResource DialogMutedBrush}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Margin="0,18,0,0"
                                           Text="Publish revision"
                                           Style="{StaticResource DialogLabelStyle}"/>
                                <ComboBox Margin="0,8,0,0"
                                          Style="{StaticResource DialogComboBoxStyle}"
                                          IsEnabled="False">
                                    <ComboBoxItem Content="Latest released revision"/>
                                </ComboBox>
                                <Border Margin="0,14,0,0"
                                        Padding="12"
                                        CornerRadius="8"
                                        Background="#FFF7E8"
                                        BorderBrush="#F8C983"
                                        BorderThickness="1">
                                    <TextBlock Text="Backend method and Aras workflow package must be deployed before submit actions are enabled."
                                               Foreground="#8B5800"
                                               FontSize="12"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Target Standard Library" Style="{StaticResource DialogLabelStyle}"/>
                            <ComboBox Margin="0,8,0,0"
                                      Style="{StaticResource DialogComboBoxStyle}"
                                      IsEnabled="False">
                                <ComboBoxItem Content="Standard Mechanical Parts"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Reviewer" Style="{StaticResource DialogLabelStyle}"/>
                            <TextBox Margin="0,8,0,0"
                                     Style="{StaticResource DialogTextBoxStyle}"
                                     Text="Library manager"
                                     IsReadOnly="True"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,16,0,0">
                        <TextBlock Text="Review comment" Style="{StaticResource DialogLabelStyle}"/>
                        <TextBox Height="76"
                                 Margin="0,8,0,0"
                                 Padding="12,10"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 Style="{StaticResource DialogTextBoxStyle}"
                                 Text="Publish workflow backend is not available yet."
                                 IsReadOnly="True"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="#FAFCFF"
                    BorderBrush="{StaticResource DialogLineBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="26,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Width="104"
                            Content="Close"
                            IsCancel="True"
                            Style="{StaticResource DialogButtonStyle}"/>
                    <Button Width="170"
                            Margin="10,0,0,0"
                            Content="View Where Used"
                            IsEnabled="False"
                            Style="{StaticResource DialogButtonStyle}"/>
                    <Button Width="160"
                            Margin="10,0,0,0"
                            Content="Submit for Review"
                            IsEnabled="False"
                            Style="{StaticResource DialogPrimaryButtonStyle}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
