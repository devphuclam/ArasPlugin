<Window x:Class="IdeaCadConnector.Desktop.PartRevisionBrowserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:IdeaCadConnector.Core.Localization;assembly=IdeaCadConnector.Core"
        Title="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[RevisionBrowserTitle]}" Width="880" Height="640"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFD">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <Style x:Key="RevisionGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EDF1F7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FBFCFE"/>
        </Style>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#17305F"/>
            <Setter Property="BorderBrush" Value="#CCD8E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="White" BorderBrush="#E4EAF3" BorderThickness="0,0,0,1" Padding="20,16">
            <StackPanel>
                <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[RevisionBrowserTitle]}" FontSize="20" FontWeight="Bold" Foreground="#17305F"/>
                <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[RevisionBrowserSubtitle]}"
                           Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#687995" FontSize="12"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="#F0F5FF" Padding="20,12" BorderBrush="#E4EAF3" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[RevisionBrowserPartNumberLabel]}" FontWeight="SemiBold" Foreground="#334B76" FontSize="11"/>
                    <TextBlock Text="{Binding PartNumber}" Foreground="#17305F" Margin="4,0,0,0" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[RevisionBrowserPartNameLabel]}" FontWeight="SemiBold" Foreground="#334B76" FontSize="11"/>
                    <TextBlock Text="{Binding PartName}" Foreground="#17305F" Margin="4,0,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[RevisionBrowserConfigIdLabel]}" FontWeight="SemiBold" Foreground="#334B76" FontSize="11"/>
                    <TextBlock Text="{Binding ConfigId}" Foreground="#687995" Margin="4,0,0,0" FontSize="12"/>
                </StackPanel>
                <StackPanel Grid.Column="6" Orientation="Horizontal" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[RevisionBrowserCurrentRevisionPolicy]}" FontWeight="SemiBold" Foreground="#334B76" FontSize="11"/>
                    <TextBlock Text="{Binding CurrentRevisionPolicy}" Foreground="#17305F" Margin="4,0,0,0"/>
                </StackPanel>
                <Button Grid.Column="7" Style="{StaticResource DialogButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[RevisionBrowserRefreshButton]}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="20,12,20,0">
            <DataGrid Style="{StaticResource RevisionGridStyle}"
                      ItemsSource="{Binding Revisions}" SelectedItem="{Binding SelectedRevision}"
                      Visibility="{Binding HasLoaded, Converter={StaticResource BoolToVisibilityConverter}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[RevisionBrowserColumnPartNumber]}" Binding="{Binding PartNumber}" Width="1.2*"/>
                    <DataGridTextColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[RevisionBrowserColumnName]}" Binding="{Binding Name}" Width="1.5*"/>
                    <DataGridTextColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[RevisionBrowserColumnMajorRev]}" Binding="{Binding MajorRev}" Width="70"/>
                    <DataGridTextColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[RevisionBrowserColumnGeneration]}" Binding="{Binding Generation}" Width="70"/>
                    <DataGridTextColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[RevisionBrowserColumnLifecycleState]}" Binding="{Binding LifecycleState}" Width="1*"/>
                    <DataGridTextColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[RevisionBrowserColumnCurrent]}" Binding="{Binding IsCurrent}" Width="60"/>
                    <DataGridTextColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[RevisionBrowserColumnReleased]}" Binding="{Binding IsReleased}" Width="60"/>
                    <DataGridTextColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[RevisionBrowserColumnCadStatus]}" Binding="{Binding CadStatus}" Width="0.9*"/>
                    <DataGridTextColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[RevisionBrowserColumnModifiedOn]}" Binding="{Binding ModifiedOn}" Width="0.9*"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="{Binding StatusMessage}"
                       Visibility="{Binding HasNoConfigId, Converter={StaticResource BoolToVisibilityConverter}}"
                       Margin="16" TextWrapping="Wrap" Foreground="#687995" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding ErrorMessage}"
                       Margin="16" TextWrapping="Wrap" Foreground="#B91C1C" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid>

        <Border Grid.Row="3" Background="White" Padding="20,8" BorderBrush="#E4EAF3" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[RevisionBrowserPageSizeLabel]}" FontSize="12" Foreground="#687995" VerticalAlignment="Center"/>
                    <ComboBox Width="70" Margin="6,0,0,0" Height="30"
                              ItemsSource="{Binding PageSizeOptions}"
                              SelectedItem="{Binding SelectedPageSize}"
                              FontSize="12"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource DialogButtonStyle}" Margin="12,0,0,0"
                        Command="{Binding PreviousPageCommand}"
                        Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[RevisionBrowserPreviousPageButton]}"/>
                <Button Grid.Column="2" Style="{StaticResource DialogButtonStyle}" Margin="6,0,0,0"
                        Command="{Binding NextPageCommand}"
                        Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[RevisionBrowserNextPageButton]}"/>
                <TextBlock Grid.Column="3" Text="{Binding ShowPageText}" VerticalAlignment="Center"
                           Margin="12,0,0,0" FontSize="12" Foreground="#687995"/>
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button Style="{StaticResource DialogButtonStyle}"
                            Command="{Binding PinCommand}"
                            Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[RevisionBrowserPinButton]}"
                            Background="#0B57F0" Foreground="White" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource DialogButtonStyle}"
                            Command="{Binding CancelCommand}"
                            Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[RevisionBrowserCancelButton]}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4" Background="#F8FAFD" Padding="20,6"
                Visibility="{Binding PinSuccess, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#16A34A" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>
