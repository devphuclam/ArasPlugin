<Window x:Class="IdeaCadConnector.Desktop.ArasPartPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:IdeaCadConnector.Core.Localization;assembly=IdeaCadConnector.Core"
        Title="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerTitle]}"
        Width="1060"
        Height="780"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#EEF3FA"
        FontFamily="Segoe UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <SolidColorBrush x:Key="DialogTextBrush" Color="#172B55"/>
        <SolidColorBrush x:Key="DialogMutedBrush" Color="#61708E"/>
        <SolidColorBrush x:Key="DialogLineBrush" Color="#D9E3F0"/>
        <SolidColorBrush x:Key="DialogPrimaryBrush" Color="#1E5AF7"/>

        <Style x:Key="DialogLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#28416C"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="DialogTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource DialogTextBrush}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C9D6EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="DialogComboBoxStyle"
               TargetType="{x:Type ComboBox}"
               BasedOn="{StaticResource SharedComboBoxStyle}"/>

        <Style x:Key="DialogButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Foreground" Value="{StaticResource DialogTextBrush}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C9D6EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F4F7FC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogPrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource DialogPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DialogPrimaryBrush}"/>
        </Style>

        <Style x:Key="PickerGridStyle" TargetType="{x:Type DataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EDF1F7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="46"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FBFCFE"/>
        </Style>
    </Window.Resources>

    <Border Margin="18" Background="White" BorderBrush="#DDE6F2" BorderThickness="1" CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border BorderBrush="{StaticResource DialogLineBrush}" BorderThickness="0,0,0,1" Padding="26,22,26,18">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerTitle]}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource DialogTextBrush}"/>
                        <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerSubtitle]}"
                                   Margin="0,6,0,0"
                                   Foreground="{StaticResource DialogMutedBrush}"
                                   FontSize="13"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Width="32"
                            Height="32"
                            Content="x"
                            FontSize="16"
                            IsCancel="True"
                            Style="{StaticResource DialogButtonStyle}"
                            BorderThickness="0"
                            Background="Transparent"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="#F8FBFF" BorderBrush="{StaticResource DialogLineBrush}" BorderThickness="0,0,0,1" Padding="26,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.65*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.05*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.05*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="0.9*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerKeywordLabel]}" Style="{StaticResource DialogLabelStyle}"/>
                        <TextBox Margin="0,7,0,0" Style="{StaticResource DialogTextBoxStyle}" Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerTypeLabel]}" Style="{StaticResource DialogLabelStyle}"/>
                        <TextBox Margin="0,7,0,0" Style="{StaticResource DialogTextBoxStyle}" Text="{Binding PartType, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerLifecycleStateLabel]}" Style="{StaticResource DialogLabelStyle}"/>
                        <TextBox Margin="0,7,0,0" Style="{StaticResource DialogTextBoxStyle}" Text="{Binding LifecycleState, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerRevisionLabel]}" Style="{StaticResource DialogLabelStyle}"/>
                        <TextBox Margin="0,7,0,0" Style="{StaticResource DialogTextBoxStyle}" Text="{Binding MajorRev, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <CheckBox Grid.Column="8" Margin="0,26,0,0"
                              VerticalAlignment="Center"
                              Foreground="{StaticResource DialogTextBrush}"
                              IsChecked="{Binding CurrentOnly}"
                              Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerCurrentOnlyCheckbox]}"/>
                    <StackPanel Grid.Column="10">
                        <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerPageSizeLabel]}" Style="{StaticResource DialogLabelStyle}"/>
                        <ComboBox Width="92" Margin="0,7,0,0" Style="{StaticResource DialogComboBoxStyle}" ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding SelectedPageSize}"/>
                    </StackPanel>
                    <Button Grid.Column="12"
                            Width="124"
                            Margin="0,23,0,0"
                            Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerSearchButton]}"
                            Command="{Binding SearchCommand}"
                            Style="{StaticResource DialogPrimaryButtonStyle}"/>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="26,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.1*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource DialogLineBrush}" BorderThickness="1" CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Margin="16,14,16,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerTitle]}"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource DialogTextBrush}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Width="32" Height="32" Content="&#xE76B;" FontFamily="Segoe MDL2 Assets" Command="{Binding PreviousPageCommand}" Style="{StaticResource DialogButtonStyle}" Padding="0"/>
                                <Button Width="32" Height="32" Margin="6,0,0,0" Content="&#xE76C;" FontFamily="Segoe MDL2 Assets" Command="{Binding NextPageCommand}" Style="{StaticResource DialogButtonStyle}" Padding="0"/>
                            </StackPanel>
                        </Grid>

                        <DataGrid Grid.Row="1"
                                  Style="{StaticResource PickerGridStyle}"
                                  ItemsSource="{Binding SearchResults}"
                                  SelectedItem="{Binding SelectedPart}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerColumnPartNumber]}" Binding="{Binding PartNumber}" Width="1.2*"/>
                                <DataGridTextColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerColumnName]}" Binding="{Binding Name}" Width="1.6*"/>
                                <DataGridTextColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerColumnType]}" Binding="{Binding PartType}" Width="0.8*"/>
                                <DataGridTextColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerColumnRevision]}" Binding="{Binding MajorRev}" Width="54"/>
                                <DataGridTextColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerColumnGeneration]}" Binding="{Binding Generation}" Width="58"/>
                                <DataGridTextColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerColumnLifecycleState]}" Binding="{Binding LifecycleState}" Width="0.9*"/>
                                <DataGridCheckBoxColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerColumnCurrent]}" Binding="{Binding IsCurrent}" Width="54"/>
                                <DataGridCheckBoxColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerColumnReleased]}" Binding="{Binding IsReleased}" Width="62"/>
                                <DataGridTextColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerColumnCadStatus]}" Binding="{Binding CadStatus}" Width="0.9*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Grid.Row="1"
                                   Text="{Binding StatusMessage}"
                                   Visibility="{Binding HasSearched, Converter={StaticResource BoolToVisibilityConverter}}"
                                   Margin="18"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource DialogMutedBrush}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>

                        <Border Grid.Row="1" Background="#F7F9FD" Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerLoading]}"
                                       Margin="16"
                                       Foreground="{StaticResource DialogMutedBrush}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </Border>

                        <Border Grid.Row="2" Margin="16,0,16,12" Padding="10,7" Background="#EEF4FF" CornerRadius="8">
                            <TextBlock Text="{Binding PagingSummary}" FontSize="12" Foreground="#28416C"/>
                        </Border>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="White" BorderBrush="{StaticResource DialogLineBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerPreviewHeader]}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource DialogTextBrush}"/>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="112"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="27"/><RowDefinition Height="27"/><RowDefinition Height="27"/><RowDefinition Height="27"/>
                                        <RowDefinition Height="27"/><RowDefinition Height="27"/><RowDefinition Height="27"/><RowDefinition Height="27"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerPreviewPartId]}" Foreground="{StaticResource DialogMutedBrush}" FontSize="12"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PartPreview.PartId}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Row="1" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerPreviewConfigId]}" Foreground="{StaticResource DialogMutedBrush}" FontSize="12"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PartPreview.ConfigId}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Row="2" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerColumnPartNumber]}" Foreground="{StaticResource DialogMutedBrush}" FontSize="12"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedPart.PartNumber}" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Grid.Row="3" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerPreviewRevision]}" Foreground="{StaticResource DialogMutedBrush}" FontSize="12"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PartPreview.Revision}" FontSize="12"/>
                                    <TextBlock Grid.Row="4" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerPreviewLifecycleState]}" Foreground="{StaticResource DialogMutedBrush}" FontSize="12"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PartPreview.LifecycleState}" FontSize="12"/>
                                    <TextBlock Grid.Row="5" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerPreviewGeneration]}" Foreground="{StaticResource DialogMutedBrush}" FontSize="12"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding PartPreview.Generation}" FontSize="12"/>
                                    <TextBlock Grid.Row="6" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerPreviewCadStatus]}" Foreground="{StaticResource DialogMutedBrush}" FontSize="12"/>
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding PartPreview.CadStatus}" FontSize="12"/>
                                    <TextBlock Grid.Row="7" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerPreviewEligibility]}" Foreground="{StaticResource DialogMutedBrush}" FontSize="12"/>
                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding PartPreview.IsEligibleForReuse}" FontSize="12" FontWeight="SemiBold"/>
                                </Grid>

                                <TextBlock Text="{Binding PartPreview.IneligibilityReason}"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="#B91C1C"
                                           FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" BorderBrush="{StaticResource DialogLineBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerTargetLibrary]}" Style="{StaticResource DialogLabelStyle}"/>
                                <ComboBox Margin="0,7,0,0" Style="{StaticResource DialogComboBoxStyle}" ItemsSource="{Binding Libraries}" DisplayMemberPath="Name" SelectedItem="{Binding TargetLibrary}"/>
                                <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[SaveToLibraryRevisionPolicyLabel]}" Style="{StaticResource DialogLabelStyle}" Margin="0,13,0,0"/>
                                <ComboBox Margin="0,7,0,0" Style="{StaticResource DialogComboBoxStyle}" ItemsSource="{Binding RevisionPolicies}" SelectedItem="{Binding RevisionPolicy}"/>
                                <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerCategory]}" Style="{StaticResource DialogLabelStyle}" Margin="0,13,0,0"/>
                                <TextBox Margin="0,7,0,0" Style="{StaticResource DialogTextBoxStyle}" Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerTags]}" Style="{StaticResource DialogLabelStyle}" Margin="0,13,0,0"/>
                                <TextBox Margin="0,7,0,0" Style="{StaticResource DialogTextBoxStyle}" Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerNote]}" Style="{StaticResource DialogLabelStyle}" Margin="0,13,0,0"/>
                                <TextBox Height="72" Margin="0,7,0,0" Padding="12,9" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Style="{StaticResource DialogTextBoxStyle}" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding StatusMessage}" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource DialogMutedBrush}"/>
                        <TextBlock Text="{Binding ErrorMessage}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#B91C1C"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="3" Background="#FAFCFF" BorderBrush="{StaticResource DialogLineBrush}" BorderThickness="0,1,0,0" Padding="26,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Width="104" Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerCancelButton]}" IsCancel="True" Command="{Binding CancelCommand}" Style="{StaticResource DialogButtonStyle}"/>
                    <Button Width="150" Margin="10,0,0,0" Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerAddButton]}" Command="{Binding AddCommand}" Style="{StaticResource DialogPrimaryButtonStyle}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
