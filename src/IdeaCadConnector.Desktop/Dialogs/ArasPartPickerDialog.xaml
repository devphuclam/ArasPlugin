<Window x:Class="IdeaCadConnector.Desktop.ArasPartPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:IdeaCadConnector.Core.Localization;assembly=IdeaCadConnector.Core"
        Title="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerTitle]}" Width="960" Height="760"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFD">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="White" BorderBrush="#E4EAF3" BorderThickness="0,0,0,1" Padding="24,20">
            <StackPanel>
                <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerTitle]}" FontSize="24" FontWeight="Bold" Foreground="#17305F"/>
                <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerSubtitle]}"
                           Margin="0,5,0,0" Foreground="#687995"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#E4EAF3" BorderThickness="0,0,0,1" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.8*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerKeywordLabel]}" FontWeight="SemiBold" Foreground="#334B76" FontSize="12"/>
                    <TextBox Height="36" Margin="0,4,0,0" Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerTypeLabel]}" FontWeight="SemiBold" Foreground="#334B76" FontSize="12"/>
                    <TextBox Height="36" Margin="0,4,0,0" Text="{Binding PartType, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerLifecycleStateLabel]}" FontWeight="SemiBold" Foreground="#334B76" FontSize="12"/>
                    <TextBox Height="36" Margin="0,4,0,0" Text="{Binding LifecycleState, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="6">
                    <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerRevisionLabel]}" FontWeight="SemiBold" Foreground="#334B76" FontSize="12"/>
                    <TextBox Height="36" Margin="0,4,0,0" Text="{Binding MajorRev, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <CheckBox Grid.Column="8" Margin="0,20,0,0"
                          VerticalAlignment="Center"
                          IsChecked="{Binding CurrentOnly}"
                          Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerCurrentOnlyCheckbox]}"/>
                <StackPanel Grid.Column="10">
                    <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerPageSizeLabel]}" FontWeight="SemiBold" Foreground="#334B76" FontSize="12"/>
                    <ComboBox Width="90" Height="36" Margin="0,4,0,0"
                              ItemsSource="{Binding PageSizeOptions}"
                              SelectedItem="{Binding SelectedPageSize}"/>
                </StackPanel>
                <Button Grid.Column="12" Width="120" Height="36" Margin="0,16,0,0"
                        Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerSearchButton]}"
                        Command="{Binding SearchCommand}"
                        Background="#0B57F0" Foreground="White"
                        FontWeight="SemiBold"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="24,12,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#DDE5F1" BorderThickness="1" CornerRadius="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="16,12,16,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerTitle]}"
                                   FontWeight="Bold" Foreground="#17305F" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Width="32" Height="32"
                                    Content="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="16"
                                    Command="{Binding PreviousPageCommand}"
                                    BorderThickness="1" BorderBrush="#CCD8E8" Background="White"/>
                            <Button Width="32" Height="32" Margin="4,0,0,0"
                                    Content="&#xE76B;" FontFamily="Segoe Fluent Icons" FontSize="16"
                                    Command="{Binding NextPageCommand}"
                                    BorderThickness="1" BorderBrush="#CCD8E8" Background="White"/>
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EDF1F7"
                              BorderThickness="0"
                              RowHeight="48"
                              ColumnHeaderHeight="36"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              Background="White"
                              ItemsSource="{Binding SearchResults}"
                              SelectedItem="{Binding SelectedPart}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerColumnPartNumber]}" Binding="{Binding PartNumber}" Width="1.2*"/>
                            <DataGridTextColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerColumnName]}" Binding="{Binding Name}" Width="1.5*"/>
                            <DataGridTextColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerColumnType]}" Binding="{Binding PartType}" Width="0.8*"/>
                            <DataGridTextColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerColumnRevision]}" Binding="{Binding MajorRev}" Width="60"/>
                            <DataGridTextColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerColumnGeneration]}" Binding="{Binding Generation}" Width="70"/>
                            <DataGridTextColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerColumnLifecycleState]}" Binding="{Binding LifecycleState}" Width="0.8*"/>
                            <DataGridCheckBoxColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerColumnCurrent]}" Binding="{Binding IsCurrent}" Width="55"/>
                            <DataGridCheckBoxColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerColumnReleased]}" Binding="{Binding IsReleased}" Width="65"/>
                            <DataGridTextColumn Header="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerColumnCadStatus]}" Binding="{Binding CadStatus}" Width="0.9*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="1" Text="{Binding StatusMessage}"
                               Visibility="{Binding HasSearched, Converter={StaticResource BoolToVisibilityConverter}}"
                               Margin="16" TextWrapping="Wrap"
                               Foreground="#687995" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                    <Border Grid.Row="1" Background="#F7F9FD"
                            Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerLoading]}"
                                   Margin="16" Foreground="#687995"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>

                    <Border Grid.Row="2" Margin="16,0,16,8" Padding="8,6"
                            Background="#F0F4FE" CornerRadius="8">
                        <TextBlock Text="{Binding PagingSummary}" FontSize="12" Foreground="#334B76"/>
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="White" BorderBrush="#DDE5F1" BorderThickness="1" CornerRadius="14" Padding="16">
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerPreviewHeader]}"
                                       FontSize="16" FontWeight="Bold" Foreground="#17305F"/>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/>
                                    <RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/>
                                    <RowDefinition Height="26"/><RowDefinition Height="26"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerPreviewPartId]}" Foreground="#687995" FontSize="12"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PartPreview.PartId}" FontSize="12"/>
                                <TextBlock Grid.Row="1" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerPreviewConfigId]}" Foreground="#687995" FontSize="12"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PartPreview.ConfigId}" FontSize="12"/>
                                <TextBlock Grid.Row="2" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerColumnPartNumber]}" Foreground="#687995" FontSize="12"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedPart.PartNumber}" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Row="3" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerPreviewRevision]}" Foreground="#687995" FontSize="12"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PartPreview.Revision}" FontSize="12"/>
                                <TextBlock Grid.Row="4" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerPreviewLifecycleState]}" Foreground="#687995" FontSize="12"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PartPreview.LifecycleState}" FontSize="12"/>
                                <TextBlock Grid.Row="5" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerPreviewGeneration]}" Foreground="#687995" FontSize="12"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding PartPreview.Generation}" FontSize="12"/>
                                <TextBlock Grid.Row="6" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerPreviewCadStatus]}" Foreground="#687995" FontSize="12"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding PartPreview.CadStatus}" FontSize="12"/>
                                <TextBlock Grid.Row="7" Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerPreviewEligibility]}" Foreground="#687995" FontSize="12"/>
                                <TextBlock Grid.Row="7" Grid.Column="1"
                                           Text="{Binding PartPreview.IsEligibleForReuse}"
                                           FontSize="12" FontWeight="SemiBold"/>
                            </Grid>

                            <TextBlock Text="{Binding PartPreview.IneligibilityReason}"
                                       Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#B91C1C" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" BorderBrush="#DDE5F1" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerTargetLibrary]}"
                                       FontWeight="SemiBold" Foreground="#334B76"/>
                            <ComboBox Height="36" Margin="0,6,0,0"
                                      ItemsSource="{Binding Libraries}"
                                      DisplayMemberPath="Name"
                                      SelectedItem="{Binding TargetLibrary}"/>

                            <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[SaveToLibraryRevisionPolicyLabel]}"
                                       FontWeight="SemiBold" Foreground="#334B76" Margin="0,12,0,0"/>
                            <ComboBox Height="36" Margin="0,6,0,0"
                                      ItemsSource="{Binding RevisionPolicies}"
                                      SelectedItem="{Binding RevisionPolicy}"/>

                            <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerCategory]}"
                                       FontWeight="SemiBold" Foreground="#334B76" Margin="0,12,0,0"/>
                            <TextBox Height="36" Margin="0,6,0,0" Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerTags]}"
                                       FontWeight="SemiBold" Foreground="#334B76" Margin="0,12,0,0"/>
                            <TextBox Height="36" Margin="0,6,0,0" Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerNote]}"
                                       FontWeight="SemiBold" Foreground="#334B76" Margin="0,12,0,0"/>
                            <TextBox Height="72" Margin="0,6,0,0" AcceptsReturn="True" TextWrapping="Wrap"
                                     Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding StatusMessage}" Margin="0,8,0,0"
                               TextWrapping="Wrap" Foreground="#687995"/>
                    <TextBlock Text="{Binding ErrorMessage}" Margin="0,4,0,0"
                               TextWrapping="Wrap" Foreground="#B91C1C"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="3" Background="White" BorderBrush="#E4EAF3" BorderThickness="0,1,0,0" Padding="24,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="110" Height="40"
                        Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerCancelButton]}"
                        IsCancel="True" Command="{Binding CancelCommand}"/>
                <Button Width="160" Height="40" Margin="10,0,0,0"
                        Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[PartPickerAddButton]}"
                        Command="{Binding AddCommand}"
                        Background="#0B57F0" Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
