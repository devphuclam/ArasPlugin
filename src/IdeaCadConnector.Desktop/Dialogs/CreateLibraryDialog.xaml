<Window x:Class="IdeaCadConnector.Desktop.CreateLibraryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:IdeaCadConnector.Core.Localization;assembly=IdeaCadConnector.Core"
        Title="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[CreateLibraryTitle]}"
        Width="560"
        Height="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#EEF3FA"
        FontFamily="Segoe UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <SolidColorBrush x:Key="DialogTextBrush" Color="#172B55"/>
        <SolidColorBrush x:Key="DialogMutedBrush" Color="#61708E"/>
        <SolidColorBrush x:Key="DialogLineBrush" Color="#D9E3F0"/>
        <SolidColorBrush x:Key="DialogPrimaryBrush" Color="#1E5AF7"/>

        <Style x:Key="DialogLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#28416C"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="DialogTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource DialogTextBrush}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C9D6EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="DialogComboBoxStyle"
               TargetType="{x:Type ComboBox}"
               BasedOn="{StaticResource SharedComboBoxStyle}"/>

        <Style x:Key="DialogButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Foreground" Value="{StaticResource DialogTextBrush}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C9D6EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F4F7FC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogPrimaryButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource DialogPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DialogPrimaryBrush}"/>
        </Style>
    </Window.Resources>

    <Border Margin="18"
            Background="White"
            BorderBrush="#DDE6F2"
            BorderThickness="1"
            CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border BorderBrush="{StaticResource DialogLineBrush}" BorderThickness="0,0,0,1" Padding="26,22,26,18">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[CreateLibraryTitle]}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource DialogTextBrush}"/>
                        <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[CreateLibrarySubtitle]}"
                                   Margin="0,6,0,0"
                                   Foreground="{StaticResource DialogMutedBrush}"
                                   FontSize="13"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Width="32"
                            Height="32"
                            Content="x"
                            FontSize="16"
                            IsCancel="True"
                            Style="{StaticResource DialogButtonStyle}"
                            BorderThickness="0"
                            Background="Transparent"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="26,22">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[CreateLibraryNameLabel]}"
                                   Style="{StaticResource DialogLabelStyle}"/>
                        <TextBox Margin="0,8,0,0"
                                 Style="{StaticResource DialogTextBoxStyle}"
                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Margin="0,16,0,0">
                        <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[CreateLibraryDescriptionLabel]}"
                                   Style="{StaticResource DialogLabelStyle}"/>
                        <TextBox Height="102"
                                 Margin="0,8,0,0"
                                 Padding="12,10"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 Style="{StaticResource DialogTextBoxStyle}"
                                 Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[CreateLibraryTypeLabel]}"
                                       Style="{StaticResource DialogLabelStyle}"/>
                            <ComboBox Margin="0,8,0,0"
                                      Style="{StaticResource DialogComboBoxStyle}"
                                      ItemsSource="{Binding LibraryTypes}"
                                      SelectedItem="{Binding SelectedType}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[CreateLibraryDefaultRevisionPolicyLabel]}"
                                       Style="{StaticResource DialogLabelStyle}"/>
                            <ComboBox Margin="0,8,0,0"
                                      Style="{StaticResource DialogComboBoxStyle}"
                                      ItemsSource="{Binding RevisionPolicies}"
                                      SelectedItem="{Binding DefaultRevisionPolicy}"/>
                        </StackPanel>
                    </Grid>

                    <Border Margin="0,18,0,0"
                            Background="#F8FBFF"
                            BorderBrush="{StaticResource DialogLineBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14">
                        <CheckBox IsChecked="{Binding IsPublic}"
                                  Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[CreateLibraryIsPublicLabel]}"
                                  Foreground="{StaticResource DialogTextBrush}"
                                  FontWeight="SemiBold"/>
                    </Border>

                    <TextBlock Margin="0,16,0,0"
                               Text="{Binding ValidationMessage}"
                               Foreground="#8B5800"
                               TextWrapping="Wrap"/>

                    <Border Margin="0,10,0,0"
                            Padding="12"
                            CornerRadius="8"
                            Background="#ECFDF3"
                            BorderBrush="#BDECCB"
                            BorderThickness="1"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[CreateLibrarySaving]}"
                                   Foreground="#087443"
                                   TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="#FAFCFF"
                    BorderBrush="{StaticResource DialogLineBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="26,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Width="104"
                            Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[CreateLibraryCancelButton]}"
                            IsCancel="True"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource DialogButtonStyle}"/>
                    <Button Width="168"
                            Margin="10,0,0,0"
                            Content="{Binding Source={x:Static core:LocalizationSource.Instance}, Path=[CreateLibrarySaveButton]}"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource DialogPrimaryButtonStyle}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
