<Window x:Class="IdeaCadConnector.Desktop.WithdrawConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Withdraw Submission"
        Width="420"
        Height="240"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#EEF3FA"
        FontFamily="Segoe UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <SolidColorBrush x:Key="DialogTextBrush" Color="#172B55"/>
        <SolidColorBrush x:Key="DialogMutedBrush" Color="#61708E"/>
        <SolidColorBrush x:Key="DialogLineBrush" Color="#D9E3F0"/>
        <Style x:Key="DialogButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root" Background="White" BorderBrush="#C9D6EA" BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F4F7FC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Margin="18" Background="White" BorderBrush="#DDE6F2" BorderThickness="1" CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border BorderBrush="{StaticResource DialogLineBrush}" BorderThickness="0,0,0,1" Padding="26,22,26,18">
                <StackPanel>
                    <TextBlock Text="Withdraw Submission" FontSize="22" FontWeight="Bold" Foreground="{StaticResource DialogTextBrush}"/>
                    <TextBlock Text="Withdraw this submission before the reviewer acts." Margin="0,4,0,0" Foreground="{StaticResource DialogMutedBrush}" FontSize="13"/>
                </StackPanel>
            </Border>
            <StackPanel Grid.Row="1" Margin="26,22" VerticalAlignment="Center">
                <TextBlock x:Name="SubmissionInfo" Foreground="{StaticResource DialogTextBrush}" FontSize="14" TextWrapping="Wrap"/>
                <TextBlock Text="Are you sure you want to withdraw this submission? The CAD revision will return to the design state." Margin="0,12,0,0" Foreground="{StaticResource DialogMutedBrush}" FontSize="13" TextWrapping="Wrap"/>
            </StackPanel>
            <Border Grid.Row="2" Background="#FAFCFF" BorderBrush="{StaticResource DialogLineBrush}" BorderThickness="0,1,0,0" Padding="26,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Width="104" Content="Cancel" IsCancel="True" Style="{StaticResource DialogButtonStyle}"/>
                    <Button x:Name="ConfirmButton" Width="140" Margin="10,0,0,0" Content="Withdraw" IsDefault="True" Click="ConfirmButton_Click" Style="{StaticResource DialogButtonStyle}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
