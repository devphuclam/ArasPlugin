<Window x:Class="IdeaCadConnector.Ui.Views.LoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aras Login Test"
        Width="1080"
        Height="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="100" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,12,8" VerticalAlignment="Center" Text="Server" />
    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" />

    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,12,8" VerticalAlignment="Center" Text="Database" />
    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}" />

    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,12,8" VerticalAlignment="Center" Text="User" />
    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />

    <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,12,8" VerticalAlignment="Center" Text="Password" />
    <PasswordBox x:Name="PasswordInput" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" PasswordChanged="OnPasswordChanged" />

    <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Margin="0,4,0,8" Foreground="Firebrick" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />

    <Border Grid.Row="5" Grid.ColumnSpan="2" Margin="0,0,0,8" Padding="12" BorderBrush="#FFB7C9B9" BorderThickness="1" Background="#FFF7FBF7">
      <StackPanel>
        <TextBlock FontWeight="SemiBold" Text="{Binding ConnectionMessage}" TextWrapping="Wrap" />
        <TextBlock Margin="0,8,0,0" Text="{Binding ConnectionDetails}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="6" Grid.ColumnSpan="2" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="100" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" Text="Part Search" />
      <TextBox Grid.Column="1" Margin="0,0,8,0" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" />
      <Button x:Name="SearchButton" Grid.Column="2" Width="120" IsEnabled="False" Click="OnSearchClicked">Search Parts</Button>
    </Grid>

    <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Margin="0,0,0,8" Foreground="#FF2C5F2D" Text="{Binding SearchStatusMessage}" TextWrapping="Wrap" />

    <DataGrid x:Name="ResultsGrid"
              Grid.Row="8"
              Grid.ColumnSpan="2"
              Margin="0,0,0,8"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              IsReadOnly="True"
              HeadersVisibility="Column"
              ItemsSource="{Binding SearchResults}"
              SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}"
              SelectionMode="Single">
      <DataGrid.Columns>
        <DataGridTextColumn Width="130" Header="Part Number" Binding="{Binding Part.PartNumber}" />
        <DataGridTextColumn Width="220" Header="Name" Binding="{Binding Part.Name}" />
        <DataGridTextColumn Width="80" Header="Revision" Binding="{Binding Part.Revision}" />
        <DataGridTextColumn Width="110" Header="State" Binding="{Binding Part.State}" />
        <DataGridTextColumn Width="120" Header="Type" Binding="{Binding Part.PartType}" />
        <DataGridTextColumn Width="150" Header="CAD Number" Binding="{Binding IronCadPartCad.CadNumber}" />
        <DataGridCheckBoxColumn Width="95" Header="Has File" Binding="{Binding IronCadPartCad.HasNativeFile}" />
        <DataGridCheckBoxColumn Width="80" Header="Locked" Binding="{Binding IronCadPartCad.IsLocked}" />
        <DataGridTextColumn Width="140" Header="Locked By" Binding="{Binding IronCadPartCad.LockedBy}" />
      </DataGrid.Columns>
    </DataGrid>

    <Border Grid.Row="9" Grid.ColumnSpan="2" Margin="0,0,0,8" Padding="12" BorderBrush="#FFD6D6D6" BorderThickness="1" Background="#FFF9F9F9">
      <StackPanel>
        <TextBlock FontWeight="SemiBold" Text="Selected Result" />
        <TextBlock Margin="0,8,0,0" FontFamily="Consolas" Text="{Binding SelectedResultDetails}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="10" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="LoginButton" Width="120" Margin="0,0,8,0" IsDefault="True" Click="OnLoginClicked">Test Connection</Button>
      <Button x:Name="RefreshButton" Width="120" Margin="0,0,8,0" IsEnabled="False" Click="OnSearchClicked">Search Parts</Button>
      <Button x:Name="CloseButton" Width="88" IsCancel="True" Click="OnCloseClicked">Close</Button>
    </StackPanel>
  </Grid>
</Window>
