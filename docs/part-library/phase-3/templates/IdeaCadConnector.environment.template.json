{
  "schemaVersion": 1,
  "environmentName": "Development",
  "aras": {
    "baseUrl": "https://your-aras-server.example.com/InnovatorServer/",
    "database": "YourDatabaseName",
    "openInArasBaseUrl": "https://your-aras-server.example.com/InnovatorServer/",
    "vaultId": "YOUR_VAULT_ID_GUID",
    "oAuthClientId": "IOMApp",
    "oAuthScope": "Innovator",
    "defaultMaxSearchResults": 20,
    "timeoutSeconds": 30
  },
  "local": {
    "vaultCacheDirectory": "%LOCALAPPDATA%/IdeaCadConnector/VaultCache",
    "ironCadExecutablePath": "",
    "openDownloadedCadAfterDownload": false
  },
  "roles": {
    "managerUsers": ["ManagerUserA"],
    "reviewerUsers": ["ReviewerUserA"],
    "contributorUsers": ["ContributorUserA"],
    "readOnlyUsers": ["ReadOnlyUserA"],
    "pdmAdministratorUsers": ["PdmAdministratorUserA"]
  },
  "diagnostics": {
    "logLevel": "Info",
    "enableFileLogging": true,
    "logDirectory": "%LOCALAPPDATA%/IdeaCadConnector/Logs"
  }
}
